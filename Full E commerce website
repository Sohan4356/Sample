
import sqlite3
from flask import Flask, request, redirect, session, render_template_string
from werkzeug.security import generate_password_hash, check_password_hash

app = Flask(__name__)
app.secret_key = "shopease_secret_key"
DB = "shopease.db"

def database():
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    return con

def setup():
    con = database()
    con.execute("""CREATE TABLE IF NOT EXISTS users(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT, email TEXT UNIQUE, password TEXT, admin INTEGER DEFAULT 0)""")
    con.execute("""CREATE TABLE IF NOT EXISTS products(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT, price REAL, category TEXT, image TEXT, description TEXT)""")
    con.execute("""CREATE TABLE IF NOT EXISTS orders(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER, total REAL)""")
    if con.execute("SELECT COUNT(*) FROM products").fetchone()[0] == 0:
        products = [
            ("Headphones",1999,"Electronics","https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600","Premium wireless headphones"),
            ("Smart Watch",2499,"Electronics","https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600","Modern smart watch"),
            ("Shoes",1799,"Fashion","https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600","Comfortable running shoes"),
            ("Backpack",1299,"Accessories","https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600","Stylish travel backpack"),
            ("Sunglasses",899,"Accessories","https://images.unsplash.com/photo-1511499767150-a48a237f0083?w=600","Classic sunglasses"),
            ("Coffee Mug",399,"Home","https://images.unsplash.com/photo-1517668808822-9ebb02f2a0e6?w=600","Ceramic coffee mug")
        ]
        con.executemany("INSERT INTO products(name,price,category,image,description) VALUES(?,?,?,?,?)",products)
    if not con.execute("SELECT id FROM users WHERE email='admin@shop.com'").fetchone():
        con.execute("INSERT INTO users(name,email,password,admin) VALUES(?,?,?,1)",
                    ("Admin","admin@shop.com",generate_password_hash("admin123")))
    con.commit()
    con.close()

