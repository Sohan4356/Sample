def page(name, **kwargs):
    con = database()
    user = con.execute("SELECT * FROM users WHERE id=?", (session.get("uid"),)).fetchone()
    count = sum(session.get("cart", {}).values())
    message = session.pop("message", "")
    data = dict(page=name,user=user,admin=bool(user and user["admin"]),
                count=count,message=message)
    data.update(kwargs)
    con.close()
    return render_template_string(HTML,**data)

@app.route("/")
def home():
    con=database()
    q=request.args.get("q","")
    products=con.execute("SELECT * FROM products WHERE name LIKE ? OR category LIKE ?",
                         (f"%{q}%",f"%{q}%")).fetchall()
    con.close()
    return page("home",products=products,search=q)

@app.route("/product/<int:id>")
def product(id):
    con=database()
    p=con.execute("SELECT * FROM products WHERE id=?",(id,)).fetchone()
    con.close()
    if not p:return redirect("/")
    return page("product",p=p)

@app.route("/register",methods=["GET","POST"])
def register():
    if request.method=="POST":
        name=request.form["name"].strip()
        email=request.form["email"].strip().lower()
        password=request.form["password"]
        if len(password)<6:
            session["message"]="Password must contain at least 6 characters."
            return redirect("/register")
        con=database()
        try:
            con.execute("INSERT INTO users(name,email,password) VALUES(?,?,?)",
                        (name,email,generate_password_hash(password)))
            con.commit()
            session["message"]="Account created. Please log in."
            return redirect("/login")
        except sqlite3.IntegrityError:
            session["message"]="Email already registered."
        finally:con.close()
    return page("auth",heading="Create Account",register=True)

@app.route("/login",methods=["GET","POST"])
def login():
    if request.method=="POST":
        con=database()
        u=con.execute("SELECT * FROM users WHERE email=?",
                      (request.form["email"].strip().lower(),)).fetchone()
        con.close()
        if u and check_password_hash(u["password"],request.form["password"]):
            session.clear()
            session["uid"]=u["id"]
            return redirect("/admin" if u["admin"] else "/")
        session["message"]="Invalid email or password."
    return page("auth",heading="Login",register=False)

@app.route("/logout")
def logout():
    session.clear()
    return redirect("/")

@app.route("/add/<int:id>",methods=["POST"])
def add(id):
    con=database()
    p=con.execute("SELECT id FROM products WHERE id=?",(id,)).fetchone()
    con.close()
    if p:
        cart=session.get("cart",{})
        cart[str(id)]=cart.get(str(id),0)+1
        session["cart"]=cart
        session["message"]="Product added to cart!"
    return redirect("/")

@app.route("/cart")
def cart():
    con=database()
    items=[]
    total=0
    for pid,qty in session.get("cart",{}).items():
        p=con.execute("SELECT * FROM products WHERE id=?",(int(pid),)).fetchone()
        if p:
            item=dict(p)
            item["qty"]=qty
            items.append(item)
            total+=p["price"]*qty
    con.close()
    return page("cart",products=items,total=total)

@app.route("/remove/<int:id>")
def remove(id):
    cart=session.get("cart",{})
    cart.pop(str(id),None)
    session["cart"]=cart
    return redirect("/cart")

@app.route("/checkout",methods=["GET","POST"])
def checkout():
    if not session.get("uid"):
        session["message"]="Please login before checkout."
        return redirect("/login")
    con=database()
    total=0
    for pid,qty in session.get("cart",{}).items():
        p=con.execute("SELECT price FROM products WHERE id=?",(int(pid),)).fetchone()
        if p:total+=p["price"]*qty
    if not session.get("cart"):
        con.close()
        return redirect("/cart")
    if request.method=="POST":
        if not request.form.get("address","").strip():
            session["message"]="Please enter your delivery address."
            con.close()
            return redirect("/checkout")
        con.execute("INSERT INTO orders(user_id,total) VALUES(?,?)",
                    (session["uid"],total))
        con.commit()
        con.close()
        session["cart"]={}
        session["message"]="Order placed successfully!"
        return redirect("/orders")
    con.close()
    return page("checkout",total=total)

@app.route("/orders")
def orders():
    if not session.get("uid"):return redirect("/login")
    con=database()
    result=con.execute("SELECT * FROM orders WHERE user_id=? ORDER BY id DESC",
                       (session["uid"],)).fetchall()
    con.close()
    return page("orders",orders=result)

def is_admin():
    if not session.get("uid"):return False
    con=database()
    u=con.execute("SELECT admin FROM users WHERE id=?",(session["uid"],)).fetchone()
    con.close()
    return bool(u and u["admin"])

@app.route("/admin",methods=["GET","POST"])
def admin():
    if not is_admin():return redirect("/login")
    con=database()
    if request.method=="POST":
        try:
            con.execute("""INSERT INTO products(name,price,category,image,description)
                VALUES(?,?,?,?,?)""",
                (request.form["name"],float(request.form["price"]),
                 request.form["category"],request.form.get("image",""),
                 request.form["description"]))
            con.commit()
            session["message"]="Product added!"
        except ValueError:
            session["message"]="Enter a valid price."
        con.close()
        return redirect("/admin")
    products=con.execute("SELECT * FROM products ORDER BY id DESC").fetchall()
    con.close()
    return page("admin",products=products)

@app.route("/delete/<int:id>")
def delete(id):
    if not is_admin():return redirect("/login")
    con=database()
    con.execute("DELETE FROM products WHERE id=?",(id,))
    con.commit()
    con.close()
    return redirect("/admin")

if __name__=="__main__":
    setup()
    app.run(debug=True)
