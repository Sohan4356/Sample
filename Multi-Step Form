
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Multi-Step Form</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #eef2ff;
    color: #1e293b;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.container {
    background: white;
    width: 100%;
    max-width: 550px;
    padding: 30px;
    border-radius: 14px;
    box-shadow: 0 8px 30px #00000012;
}

h1 {
    text-align: center;
    margin-bottom: 10px;
    color: #4f46e5;
}

.subtitle {
    text-align: center;
    color: #64748b;
    margin-bottom: 25px;
}

.progress {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
    position: relative;
}

.progress::before {
    content: "";
    position: absolute;
    top: 16px;
    left: 10%;
    width: 80%;
    height: 3px;
    background: #e2e8f0;
    z-index: 0;
}

.step {
    position: relative;
    z-index: 1;
    text-align: center;
    width: 33.33%;
    color: #64748b;
    font-size: 13px;
}

.circle {
    width: 34px;
    height: 34px;
    background: #e2e8f0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 8px;
    font-weight: bold;
}

.step.active .circle,
.step.completed .circle {
    background: #4f46e5;
    color: white;
}

.step.active {
    color: #4f46e5;
    font-weight: bold;
}

.form-step {
    display: none;
}

.form-step.active {
    display: block;
}

h2 {
    margin-bottom: 20px;
    font-size: 21px;
}

.field {
    margin-bottom: 17px;
}

label {
    display: block;
    margin-bottom: 7px;
    font-weight: bold;
    font-size: 14px;
}

input {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 15px;
}

input:focus {
    outline: 2px solid #a5b4fc;
    border-color: #4f46e5;
}

.error {
    color: #dc2626;
    font-size: 13px;
    margin-top: 5px;
    min-height: 15px;
}

.buttons {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 25px;
}

button {
    padding: 12px 20px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 15px;
}

.primary {
    background: #4f46e5;
    color: white;
}

.secondary {
    background: #e2e8f0;
    color: #1e293b;
}

button:hover {
    opacity: 0.88;
}

.review {
    background: #f8fafc;
    padding: 15px;
    border-radius: 8px;
    line-height: 2;
    overflow-wrap: anywhere;
}

.review strong {
    color: #4f46e5;
}

.success {
    text-align: center;
    padding: 25px 0;
}

.success h2 {
    color: #16a34a;
}

[hidden] {
    display: none !important;
}

@media (max-width: 480px) {
    .container {
        padding: 20px;
    }

    .step {
        font-size: 11px;
    }

    button {
        padding: 11px 14px;
    }
}
</style>
</head>

<body>

<div class="container">
    <h1>Registration Form</h1>
    <p class="subtitle">Complete all steps to register</p>

    <div class="progress" id="progress">
        <div class="step active">
            <div class="circle">1</div>
            Personal
        </div>
        <div class="step">
            <div class="circle">2</div>
            Account
        </div>
        <div class="step">
            <div class="circle">3</div>
            Review
        </div>
    </div>

    <form id="registrationForm" novalidate>
        <!-- Step 1 -->
        <section class="form-step active">
            <h2>Personal Details</h2>

            <div class="field">
                <label for="name">Full Name</label>
                <input id="name" type="text"
                       placeholder="Enter your full name"
                       autocomplete="name" required>
                <div class="error" id="nameError"></div>
            </div>

            <div class="field">
                <label for="email">Email Address</label>
                <input id="email" type="email"
                       placeholder="example@email.com"
                       autocomplete="email" required>
                <div class="error" id="emailError"></div>
            </div>

            <div class="field">
                <label for="phone">Phone Number</label>
                <input id="phone" type="tel"
                       placeholder="10-digit phone number"
                       inputmode="numeric" maxlength="10" required>
                <div class="error" id="phoneError"></div>
            </div>
        </section>

        <!-- Step 2 -->
        <section class="form-step">
            <h2>Account Details</h2>

            <div class="field">
                <label for="username">Username</label>
                <input id="username" type="text"
                       placeholder="Choose a username"
                       autocomplete="username" required>
                <div class="error" id="usernameError"></div>
            </div>

            <div class="field">
                <label for="password">Password</label>
                <input id="password" type="password"
                       placeholder="At least 8 characters"
                       autocomplete="new-password" required>
                <div class="error" id="passwordError"></div>
            </div>

            <div class="field">
                <label for="confirmPassword">Confirm Password</label>
                <input id="confirmPassword" type="password"
                       placeholder="Re-enter your password"
                       autocomplete="new-password" required>
                <div class="error" id="confirmPasswordError"></div>
            </div>
        </section>

        <!-- Step 3 -->
        <section class="form-step">
            <h2>Review Your Details</h2>
            <p>Please check your details before submitting.</p>
            <br>
            <div class="review" id="review"></div>
        </section>

        <div class="buttons" id="formButtons">
            <button type="button" class="secondary"
                    id="backBtn" hidden>← Back</button>

            <button type="button" class="primary"
                    id="nextBtn">Next →</button>

            <button type="submit" class="primary"
                    id="submitBtn" hidden>Submit</button>
        </div>
    </form>

    <div class="success" id="success" hidden>
        <h2>✓ Registration Successful!</h2>
        <p>Your form has been submitted successfully.</p>
        <br>
        <button class="primary" id="restartBtn">Start Again</button>
    </div>
</div>

<script>
const form = document.getElementById("registrationForm");
const steps = document.querySelectorAll(".form-step");
const progressSteps = document.querySelectorAll(".step");

const backBtn = document.getElementById("backBtn");
const nextBtn = document.getElementById("nextBtn");
const submitBtn = document.getElementById("submitBtn");
const review = document.getElementById("review");

let currentStep = 0;

function showStep(index) {
    currentStep = index;

    steps.forEach((step, i) => {
        step.classList.toggle("active", i === index);
    });

    progressSteps.forEach((step, i) => {
        step.classList.toggle("active", i === index);
        step.classList.toggle("completed", i < index);
    });

    backBtn.hidden = index === 0;
    nextBtn.hidden = index === steps.length - 1;
    submitBtn.hidden = index !== steps.length - 1;

    if (index === 2) {
        showReview();
    }
}

function getValue(id) {
    return document.getElementById(id).value.trim();
}

function setError(id, message) {
    document.getElementById(id + "Error").textContent = message;
}

function validateStep() {
    let valid = true;

    if (currentStep === 0) {
        const name = getValue("name");
        const email = getValue("email");
        const phone = getValue("phone");

        setError("name", "");
        setError("email", "");
        setError("phone", "");

        if (name.length < 2) {
            setError("name", "Enter your full name.");
            valid = false;
        }

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            setError("email", "Enter a valid email address.");
            valid = false;
        }

        if (!/^\d{10}$/.test(phone)) {
            setError("phone", "Enter a 10-digit phone number.");
            valid = false;
        }
    }

    if (currentStep === 1) {
        const username = getValue("username");
        const password = document.getElementById("password").value;
        const confirmPassword =
            document.getElementById("confirmPassword").value;

        setError("username", "");
        setError("password", "");
        setError("confirmPassword", "");

        if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
            setError("username",
                "Use 3–20 letters, numbers, or underscores.");
            valid = false;
        }

        if (password.length < 8) {
            setError("password",
                "Password must contain at least 8 characters.");
            valid = false;
        }

        if (password !== confirmPassword) {
            setError("confirmPassword", "Passwords do not match.");
            valid = false;
        }
    }

    return valid;
}

function showReview() {
    // Use textContent for user-provided values to avoid HTML injection.
    review.replaceChildren();

    const details = [
        ["Full Name", getValue("name")],
        ["Email", getValue("email")],
        ["Phone", getValue("phone")],
        ["Username", getValue("username")]
    ];

    details.forEach(([label, value]) => {
        const line = document.createElement("p");
        const strong = document.createElement("strong");

        strong.textContent = label + ": ";
        line.append(strong, document.createTextNode(value));
        review.appendChild(line);
    });

    const note = document.createElement("p");
    note.textContent = "Password: ••••••••";
    review.appendChild(note);
}

nextBtn.addEventListener("click", () => {
    if (validateStep()) {
        showStep(currentStep + 1);
    }
});

backBtn.addEventListener("click", () => {
    showStep(currentStep - 1);
});

form.addEventListener("submit", (event) => {
    event.preventDefault();

    if (currentStep !== 2 || !validateStep()) return;

    form.hidden = true;
    document.getElementById("progress").hidden = true;
    document.querySelector(".subtitle").hidden = true;
    document.getElementById("success").hidden = false;
});

document.getElementById("restartBtn").addEventListener("click", () => {
    form.reset();
    form.hidden = false;
    document.getElementById("progress").hidden = false;
    document.querySelector(".subtitle").hidden = false;
    document.getElementById("success").hidden = true;

    document.querySelectorAll(".error").forEach(error => {
        error.textContent = "";
    });

    showStep(0);
});
</script>

</body>
</html>
