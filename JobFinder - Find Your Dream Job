
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JobFinder - Find Your Dream Job</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #1e293b;
}

header {
    background: #4338ca;
    color: white;
    padding: 24px 7%;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
}

.hero {
    text-align: center;
    padding: 55px 10px 35px;
}

.hero h1 {
    font-size: clamp(28px, 5vw, 42px);
    margin-bottom: 15px;
}

.hero p {
    color: #e0e7ff;
    margin-bottom: 25px;
}

.search-box {
    display: flex;
    max-width: 750px;
    margin: auto;
    gap: 10px;
}

input, select {
    padding: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    background: white;
    color: #1e293b;
    min-width: 0;
}

.search-box input {
    flex: 1;
}

button {
    border: none;
    padding: 12px 18px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
}

.search-btn {
    background: #16a34a;
    color: white;
}

.container {
    max-width: 1150px;
    margin: 35px auto;
    padding: 0 20px;
}

.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0 25px;
}

.filters select {
    flex: 1;
    min-width: 170px;
}

.clear-btn {
    background: #e2e8f0;
    color: #334155;
}

.job-count {
    margin-bottom: 18px;
    color: #64748b;
}

.job-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.job-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 22px;
    transition: transform 0.2s, box-shadow 0.2s;
}

.job-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px #0000000c;
}

.job-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 15px;
}

.company-logo {
    width: 48px;
    height: 48px;
    background: #eef2ff;
    color: #4338ca;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-weight: bold;
    font-size: 20px;
    flex-shrink: 0;
}

.job-card h3 {
    margin-bottom: 7px;
}

.company {
    color: #64748b;
}

.tag {
    display: inline-block;
    background: #eef2ff;
    color: #4338ca;
    padding: 6px 9px;
    border-radius: 5px;
    font-size: 12px;
    margin: 12px 5px 12px 0;
}

.job-info {
    color: #64748b;
    line-height: 1.8;
    font-size: 14px;
}

.job-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.details-btn {
    background: #e2e8f0;
    color: #1e293b;
}

.apply-btn {
    background: #4338ca;
    color: white;
}

.job-actions button {
    flex: 1;
}

.empty {
    grid-column: 1 / -1;
    text-align: center;
    background: white;
    border-radius: 10px;
    padding: 40px 20px;
    color: #64748b;
}

footer {
    background: #1e293b;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 45px;
}

dialog {
    width: calc(100% - 32px);
    max-width: 500px;
    margin: auto;
    padding: 25px;
    border: none;
    border-radius: 12px;
    box-shadow: 0 15px 50px #00000030;
    color: #1e293b;
}

dialog::backdrop {
    background: #0f172a99;
}

dialog h2 {
    margin-bottom: 15px;
}

dialog p {
    line-height: 1.7;
    margin-bottom: 12px;
}

.modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
}

@media (max-width: 700px) {
    .job-list {
        grid-template-columns: 1fr;
    }

    .search-box {
        flex-direction: column;
    }

    nav {
        flex-wrap: wrap;
    }
}

@media (max-width: 400px) {
    .filters {
        flex-direction: column;
    }

    .filters select {
        width: 100%;
    }

    .job-card {
        padding: 16px;
    }
}
</style>
</head>

<body>

<header>
    <nav>
        <div class="logo">💼 JobFinder</div>
        <a href="#jobs">Browse Jobs</a>
    </nav>

    <section class="hero">
        <h1>Find Your Dream Job</h1>
        <p>Explore opportunities and take the next step in your career.</p>

        <div class="search-box">
            <input id="searchInput"
                   type="search"
                   placeholder="Job title, company, or location"
                   aria-label="Search jobs">

            <button class="search-btn" id="searchBtn">
                Search Jobs
            </button>
        </div>
    </section>
</header>

<main class="container" id="jobs">
    <h2>Explore Job Opportunities</h2>

    <div class="filters">
        <select id="categoryFilter" aria-label="Filter by category">
            <option value="">All Categories</option>
            <option value="Technology">Technology</option>
            <option value="Design">Design</option>
            <option value="Marketing">Marketing</option>
            <option value="Finance">Finance</option>
            <option value="Human Resources">Human Resources</option>
        </select>

        <select id="typeFilter" aria-label="Filter by job type">
            <option value="">All Job Types</option>
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Internship">Internship</option>
            <option value="Remote">Remote</option>
        </select>

        <button class="clear-btn" id="clearBtn">
            Clear Filters
        </button>
    </div>

    <p class="job-count" id="jobCount" aria-live="polite"></p>
    <div class="job-list" id="jobList"></div>
</main>

<dialog id="jobDialog">
    <h2 id="dialogTitle">Job Details</h2>
    <div id="dialogContent"></div>
    <div class="modal-actions">
        <button class="details-btn" id="closeDialog">Close</button>
        <button class="apply-btn" id="dialogApply">Apply Now</button>
    </div>
</dialog>

<footer>
    <p>© 2026 JobFinder | Your Career Starts Here</p>
</footer>

<script>
const jobs = [
    {
        id: 1,
        title: "Frontend Developer",
        company: "TechNova",
        location: "Hyderabad",
        salary: "₹4–8 LPA",
        type: "Full-time",
        category: "Technology",
        description: "Build responsive websites using HTML, CSS, JavaScript, and modern frontend tools."
    },
    {
        id: 2,
        title: "Python Developer",
        company: "CodeWorks",
        location: "Bengaluru",
        salary: "₹5–10 LPA",
        type: "Full-time",
        category: "Technology",
        description: "Develop Python applications, write clean code, and work with APIs and databases."
    },
    {
        id: 3,
        title: "UI/UX Designer",
        company: "CreativeHub",
        location: "Remote",
        salary: "₹3–7 LPA",
        type: "Remote",
        category: "Design",
        description: "Create user-friendly interfaces, wireframes, prototypes, and design systems."
    },
    {
        id: 4,
        title: "Digital Marketing Intern",
        company: "MarketPlus",
        location: "Hyderabad",
        salary: "₹10,000–15,000/month",
        type: "Internship",
        category: "Marketing",
        description: "Assist with social media campaigns, content creation, and marketing analytics."
    },
    {
        id: 5,
        title: "Data Analyst",
        company: "DataBridge",
        location: "Pune",
        salary: "₹4–9 LPA",
        type: "Full-time",
        category: "Technology",
        description: "Analyze datasets, create reports, and communicate business insights."
    },
    {
        id: 6,
        title: "HR Assistant",
        company: "PeopleFirst",
        location: "Chennai",
        salary: "₹2–4 LPA",
        type: "Part-time",
        category: "Human Resources",
        description: "Support recruitment, interview scheduling, and employee documentation."
    },
    {
        id: 7,
        title: "Finance Intern",
        company: "FinEdge",
        location: "Mumbai",
        salary: "₹12,000/month",
        type: "Internship",
        category: "Finance",
        description: "Assist the finance team with spreadsheets, reporting, and basic analysis."
    },
    {
        id: 8,
        title: "Java Developer",
        company: "AppSphere",
        location: "Remote",
        salary: "₹5–9 LPA",
        type: "Remote",
        category: "Technology",
        description: "Build and maintain Java applications and help troubleshoot software issues."
    }
];

const searchInput = document.getElementById("searchInput");
const categoryFilter = document.getElementById("categoryFilter");
const typeFilter = document.getElementById("typeFilter");
const jobList = document.getElementById("jobList");
const jobCount = document.getElementById("jobCount");
const jobDialog = document.getElementById("jobDialog");

let selectedJob = null;

function renderJobs() {
    const query = searchInput.value.trim().toLowerCase();
    const category = categoryFilter.value;
    const type = typeFilter.value;

    const filteredJobs = jobs.filter(job => {
        const searchableText =
            `${job.title} ${job.company} ${job.location}`.toLowerCase();

        const matchesSearch = searchableText.includes(query);
        const matchesCategory =
            !category || job.category === category;
        const matchesType =
            !type || job.type === type;

        return matchesSearch && matchesCategory && matchesType;
    });

    jobCount.textContent =
        `${filteredJobs.length} job${filteredJobs.length === 1 ? "" : "s"} found`;

    jobList.replaceChildren();

    if (filteredJobs.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.textContent =
            "No jobs found. Try a different search or clear the filters.";
        jobList.appendChild(empty);
        return;
    }

    filteredJobs.forEach(job => {
        const card = document.createElement("article");
        card.className = "job-card";

        // Build the card using textContent to safely display job data.
        const top = document.createElement("div");
        top.className = "job-top";

        const info = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent = job.title;

        const company = document.createElement("p");
        company.className = "company";
        company.textContent = job.company;

        info.append(title, company);

        const logo = document.createElement("div");
        logo.className = "company-logo";
        logo.setAttribute("aria-hidden", "true");
        logo.textContent = job.company.charAt(0);

        top.append(info, logo);

        const tags = document.createElement("div");
        [job.category, job.type].forEach(text => {
            const tag = document.createElement("span");
            tag.className = "tag";
            tag.textContent = text;
            tags.appendChild(tag);
        });

        const jobInfo = document.createElement("p");
        jobInfo.className = "job-info";
        jobInfo.textContent =
            `📍 ${job.location}\n💰 ${job.salary}`;
        jobInfo.style.whiteSpace = "pre-line";

        const description = document.createElement("p");
        description.style.marginTop = "12px";
        description.textContent = job.description;

        const actions = document.createElement("div");
        actions.className = "job-actions";

        const detailsBtn = document.createElement("button");
        detailsBtn.className = "details-btn";
        detailsBtn.textContent = "View Details";
        detailsBtn.addEventListener("click", () => showDetails(job.id));

        const applyBtn = document.createElement("button");
        applyBtn.className = "apply-btn";
        applyBtn.textContent = "Apply";
        applyBtn.addEventListener("click", () => applyForJob(job.id));

        actions.append(detailsBtn, applyBtn);
        card.append(top, tags, jobInfo, description, actions);
        jobList.appendChild(card);
    });
}

function showDetails(id) {
    selectedJob = jobs.find(job => job.id === id);

    document.getElementById("dialogTitle").textContent =
        selectedJob.title;

    const content = document.getElementById("dialogContent");
    content.replaceChildren();

    [
        `Company: ${selectedJob.company}`,
        `Location: ${selectedJob.location}`,
        `Salary: ${selectedJob.salary}`,
        `Job Type: ${selectedJob.type}`,
        `Category: ${selectedJob.category}`,
        selectedJob.description
    ].forEach(text => {
        const p = document.createElement("p");
        p.textContent = text;
        content.appendChild(p);
    });

    jobDialog.showModal();
}

function applyForJob(id) {
    const job = jobs.find(item => item.id === id);

    alert(
        `Demo application for "${job.title}" at ${job.company}.\n\n` +
        "This is a sample project. No real application was submitted."
    );
}

document.getElementById("searchBtn").addEventListener("click", renderJobs);

searchInput.addEventListener("input", renderJobs);
categoryFilter.addEventListener("change", renderJobs);
typeFilter.addEventListener("change", renderJobs);

document.getElementById("clearBtn").addEventListener("click", () => {
    searchInput.value = "";
    categoryFilter.value = "";
    typeFilter.value = "";
    renderJobs();
});

document.getElementById("closeDialog").addEventListener("click", () => {
    jobDialog.close();
});

document.getElementById("dialogApply").addEventListener("click", () => {
    if (selectedJob) {
        jobDialog.close();
        applyForJob(selectedJob.id);
    }
});

renderJobs();
</script>

</body>
</html>

