
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Chatbot Interface</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6fb;
    color: #202638;
    height: 100vh;
    overflow: hidden;
}

.app {
    display: flex;
    height: 100vh;
}

/* SIDEBAR */
.sidebar {
    width: 270px;
    background: #17243a;
    color: white;
    display: flex;
    flex-direction: column;
    padding: 20px 15px;
}

.logo {
    font-size: 21px;
    font-weight: bold;
    margin-bottom: 25px;
}

.new-chat {
    background: #526de5;
    color: white;
    border: none;
    padding: 13px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    margin-bottom: 25px;
}

.sidebar h4 {
    color: #9daec7;
    font-size: 12px;
    margin-bottom: 12px;
}

.history {
    flex: 1;
    overflow-y: auto;
}

.history-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px;
    border-radius: 7px;
    cursor: pointer;
    margin-bottom: 5px;
    color: #dce4f1;
    font-size: 13px;
}

.history-item:hover,
.history-item.active {
    background: #2b3d59;
}

.history-title {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.delete-chat {
    background: transparent;
    border: none;
    color: #bac7d9;
    cursor: pointer;
    font-size: 16px;
}

.sidebar-bottom {
    border-top: 1px solid #34445c;
    padding-top: 15px;
    font-size: 12px;
    color: #aab8ca;
}

/* MAIN AREA */
.main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
}

.topbar {
    height: 65px;
    background: white;
    border-bottom: 1px solid #e7eaf0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 25px;
}

.topbar h2 {
    font-size: 18px;
}

.top-actions {
    display: flex;
    gap: 10px;
}

.icon-btn {
    background: #f0f2f8;
    border: none;
    padding: 9px 12px;
    border-radius: 7px;
    cursor: pointer;
    font-size: 17px;
}

/* CHAT MESSAGES */
.chat-area {
    flex: 1;
    overflow-y: auto;
    padding: 25px 5%;
}

.welcome {
    text-align: center;
    margin: 100px auto 30px;
    max-width: 550px;
}

.welcome .robot {
    font-size: 55px;
    margin-bottom: 18px;
}

.welcome h1 {
    font-size: 29px;
    margin-bottom: 10px;
}

.welcome p {
    color: #8490a3;
    line-height: 1.6;
}

.suggestions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    max-width: 650px;
    margin: 25px auto;
}

.suggestion {
    background: white;
    border: 1px solid #e2e6ef;
    border-radius: 10px;
    padding: 15px;
    text-align: left;
    cursor: pointer;
    color: #39465d;
}

.suggestion:hover {
    border-color: #526de5;
    background: #f8f9ff;
}

.suggestion strong {
    display: block;
    margin-bottom: 6px;
}

.suggestion small {
    color: #8490a3;
}

.message {
    display: flex;
    gap: 12px;
    margin: 20px auto;
    max-width: 850px;
    align-items: flex-start;
}

.avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 17px;
}

.user-avatar {
    background: #dfe6ff;
}

.bot-avatar {
    background: #d9f5e8;
}

.message-content {
    flex: 1;
    min-width: 0;
}

.message-name {
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 7px;
    color: #66738a;
}

.message-text {
    line-height: 1.7;
    font-size: 14px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.message-actions {
    display: flex;
    gap: 8px;
    margin-top: 9px;
}

.message-actions button {
    background: transparent;
    border: none;
    color: #8490a3;
    cursor: pointer;
    font-size: 12px;
}

.message-actions button:hover {
    color: #526de5;
}

.typing {
    color: #8490a3;
    font-size: 13px;
    margin: 15px auto;
    max-width: 850px;
}

/* INPUT AREA */
.input-area {
    padding: 15px 5% 20px;
    background: #f4f6fb;
}

.input-box {
    max-width: 850px;
    margin: auto;
    background: white;
    border: 1px solid #dce1eb;
    border-radius: 13px;
    display: flex;
    align-items: flex-end;
    padding: 10px;
    gap: 10px;
    box-shadow: 0 3px 12px #17243a0b;
}

.input-box textarea {
    flex: 1;
    border: none;
    outline: none;
    resize: none;
    min-height: 40px;
    max-height: 120px;
    padding: 10px;
    font-size: 14px;
    line-height: 1.5;
}

.send-btn {
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 9px;
    background: #526de5;
    color: white;
    font-size: 19px;
    cursor: pointer;
}

.send-btn:hover {
    background: #4059c7;
}

.send-btn:disabled {
    opacity: .5;
    cursor: not-allowed;
}

.disclaimer {
    text-align: center;
    color: #9aa3b3;
    font-size: 11px;
    margin-top: 10px;
}

/* DARK MODE */
body.dark {
    background: #111827;
    color: #e7edf7;
}

body.dark .main,
body.dark .input-area {
    background: #111827;
}

body.dark .topbar,
body.dark .input-box,
body.dark .suggestion {
    background: #1e293b;
    border-color: #35445c;
    color: #e7edf7;
}

body.dark .icon-btn {
    background: #34445c;
    color: white;
}

body.dark .input-box textarea {
    background: transparent;
    color: white;
}

body.dark .suggestion small,
body.dark .welcome p {
    color: #aab8ca;
}

body.dark .suggestion:hover {
    background: #293a56;
}

body.dark .message-name,
body.dark .message-actions button,
body.dark .disclaimer {
    color: #aab8ca;
}

body.dark .welcome h1 {
    color: white;
}

body.dark .sidebar {
    background: #0b1424;
}

/* MOBILE */
@media(max-width: 700px) {
    .sidebar {
        width: 65px;
        padding: 15px 8px;
    }

    .logo {
        font-size: 0;
        text-align: center;
    }

    .logo::after {
        content: "🤖";
        font-size: 25px;
    }

    .new-chat {
        font-size: 0;
        padding: 12px 5px;
    }

    .new-chat::after {
        content: "+";
        font-size: 22px;
    }

    .sidebar h4,
    .history-title,
    .delete-chat,
    .sidebar-bottom {
        display: none;
    }

    .history-item {
        justify-content: center;
        font-size: 18px;
        padding: 12px 5px;
    }

    .topbar {
        padding: 0 12px;
    }

    .topbar h2 {
        font-size: 15px;
    }

    .chat-area {
        padding: 15px 12px;
    }

    .welcome {
        margin-top: 65px;
    }

    .welcome h1 {
        font-size: 23px;
    }

    .suggestions {
        grid-template-columns: 1fr;
    }

    .input-area {
        padding: 10px;
    }
}
</style>
</head>

<body>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">🤖 AI Assistant</div>

        <button class="new-chat" onclick="newChat()">＋ New Chat</button>

        <h4>RECENT CHATS</h4>

        <div class="history" id="historyList"></div>

        <div class="sidebar-bottom">
            AI Chatbot Interface<br>
            HTML • CSS • JavaScript
        </div>

    </aside>

    <!-- MAIN -->
    <main class="main">

        <div class="topbar">
            <h2 id="chatTitle">New Conversation</h2>

            <div class="top-actions">
                <button class="icon-btn" onclick="toggleTheme()" title="Change theme">🌙</button>
                <button class="icon-btn" onclick="newChat()" title="New chat">＋</button>
            </div>
        </div>

        <section class="chat-area" id="chatArea">

            <div class="welcome" id="welcome">

                <div class="robot">🤖</div>

                <h1>How can I help you today?</h1>

                <p>
                    I'm your AI assistant. Ask me questions,
                    learn something new, or explore ideas.
                </p>

                <div class="suggestions">

                    <button class="suggestion" onclick="useSuggestion('Explain Python programming for beginners')">
                        <strong>💻 Learn programming</strong>
                        <small>Explain coding concepts</small>
                    </button>

                    <button class="suggestion" onclick="useSuggestion('Give me a study timetable for exams')">
                        <strong>📚 Study planner</strong>
                        <small>Organize your study schedule</small>
                    </button>

                    <button class="suggestion" onclick="useSuggestion('Give me 5 creative project ideas')">
                        <strong>💡 Generate ideas</strong>
                        <small>Discover creative projects</small>
                    </button>

                    <button class="suggestion" onclick="useSuggestion('Give me tips to improve my English speaking')">
                        <strong>🗣️ Improve English</strong>
                        <small>Practice communication skills</small>
                    </button>

                </div>
            </div>

            <div id="messages"></div>

            <div id="typing" class="typing" hidden>
                🤖 AI is typing...
            </div>

        </section>

        <!-- INPUT -->
        <section class="input-area">

            <div class="input-box">

                <textarea
                    id="userInput"
                    placeholder="Message your AI assistant..."
                    rows="1"
                    onkeydown="handleKey(event)"
                    oninput="resizeInput()"
                ></textarea>

                <button class="send-btn" id="sendBtn" onclick="sendMessage()">➤</button>

            </div>

            <p class="disclaimer">
                Demo AI assistant • Responses are generated locally
            </p>

        </section>

    </main>

</div>

<script>

// ----------------------------------
// STORAGE
// ----------------------------------

const STORAGE_KEY = "aiChatbotConversations_v1";

function loadChats() {
    try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (Array.isArray(saved)) return saved;
    } catch (error) {
        console.error("Could not load chats.");
    }
    return [];
}

let chats = loadChats();
let activeChatId = null;
let isTyping = false;

function saveChats() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(chats));
        return true;
    } catch (error) {
        alert("Unable to save chat history. Browser storage may be full.");
        return false;
    }
}

function createId() {
    return Date.now() + Math.floor(Math.random() * 1000);
}

// ----------------------------------
// NEW CHAT
// ----------------------------------

function newChat() {
    if (isTyping) return;

    const chat = {
        id: createId(),
        title: "New Conversation",
        messages: []
    };

    chats.unshift(chat);
    activeChatId = chat.id;

    if (!saveChats()) {
        chats.shift();
        activeChatId = chats[0]?.id || null;
        return;
    }

    renderAll();
    document.getElementById("userInput").focus();
}

// ----------------------------------
// CURRENT CHAT
// ----------------------------------

function getCurrentChat() {
    return chats.find(chat => chat.id === activeChatId);
}

function openChat(id) {
    if (isTyping) return;

    activeChatId = id;
    renderAll();
}

function deleteChat(id, event) {
    event.stopPropagation();

    if (isTyping) return;
    if (!confirm("Delete this conversation?")) return;

    const oldChats = [...chats];
    const oldActive = activeChatId;

    chats = chats.filter(chat => chat.id !== id);

    if (activeChatId === id) {
        activeChatId = chats[0]?.id || null;
    }

    if (!saveChats()) {
        chats = oldChats;
        activeChatId = oldActive;
    }

    renderAll();
}

// ----------------------------------
// RENDER HISTORY
// ----------------------------------

function renderHistory() {
    const history = document.getElementById("historyList");

    history.innerHTML = chats.map(chat => `
        <div class="history-item ${chat.id === activeChatId ? "active" : ""}"
             onclick="openChat(${chat.id})">

            <span>💬</span>

            <span class="history-title">
                ${escapeHTML(chat.title)}
            </span>

            <button class="delete-chat"
                onclick="deleteChat(${chat.id}, event)"
                title="Delete chat">×</button>
        </div>
    `).join("");
}

// ----------------------------------
// RENDER MESSAGES
// ----------------------------------

function renderMessages() {
    const chat = getCurrentChat();
    const messages = document.getElementById("messages");
    const welcome = document.getElementById("welcome");

    messages.innerHTML = "";

    if (!chat || chat.messages.length === 0) {
        welcome.style.display = "block";
        document.getElementById("chatTitle").textContent = "New Conversation";
        return;
    }

    welcome.style.display = "none";
    document.getElementById("chatTitle").textContent = chat.title;

    chat.messages.forEach((message, index) => {
        const wrapper = document.createElement("div");
        wrapper.className = "message";

        const avatar = document.createElement("div");
        avatar.className = "avatar " +
            (message.role === "user" ? "user-avatar" : "bot-avatar");

        avatar.textContent = message.role === "user" ? "👤" : "🤖";

        const content = document.createElement("div");
        content.className = "message-content";

        const name = document.createElement("div");
        name.className = "message-name";
        name.textContent = message.role === "user" ? "You" : "AI Assistant";

        const text = document.createElement("div");
        text.className = "message-text";
        text.textContent = message.content;

        const actions = document.createElement("div");
        actions.className = "message-actions";

        const copyButton = document.createElement("button");
        copyButton.textContent = "📋 Copy";
        copyButton.onclick = () => copyMessage(message.content);

        actions.appendChild(copyButton);

        content.append(name, text, actions);
        wrapper.append(avatar, content);
        messages.appendChild(wrapper);
    });

    scrollToBottom();
}

// ----------------------------------
// SEND MESSAGE
// ----------------------------------

function handleKey(event) {
    if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        sendMessage();
    }
}

function resizeInput() {
    const input = document.getElementById("userInput");
    input.style.height = "auto";
    input.style.height = Math.min(input.scrollHeight, 120) + "px";
}

function useSuggestion(text) {
    document.getElementById("userInput").value = text;
    sendMessage();
}

function sendMessage() {
    if (isTyping) return;

    const input = document.getElementById("userInput");
    const message = input.value.trim();

    if (!message) return;

    if (!activeChatId) {
        const chat = {
            id: createId(),
            title: "New Conversation",
            messages: []
        };

        chats.unshift(chat);
        activeChatId = chat.id;

        if (!saveChats()) {
            chats.shift();
            activeChatId = null;
            return;
        }
    }

    const chat = getCurrentChat();
    const previousMessages = [...chat.messages];
    const previousTitle = chat.title;

    chat.messages.push({
        role: "user",
        content: message
    });

    if (chat.messages.length === 1) {
        chat.title = message.length > 25
            ? message.slice(0, 25) + "..."
            : message;
    }

    if (!saveChats()) {
        chat.messages = previousMessages;
        chat.title = previousTitle;
        return;
    }

    input.value = "";
    resizeInput();

    renderAll();
    showTyping();

    // Simulate AI response
    setTimeout(() => {
        const response = generateResponse(message);

        const currentChat = getCurrentChat();

        if (currentChat) {
            currentChat.messages.push({
                role: "bot",
                content: response
            });

            saveChats();
        }

        hideTyping();
        renderAll();
    }, 900 + Math.random() * 900);
}

// ----------------------------------
// DEMO AI RESPONSE ENGINE
// ----------------------------------

function generateResponse(message) {
    const text = message.toLowerCase();

    if (/\b(hi|hello|hey|good morning|good evening)\b/.test(text)) {
        return "Hello! 👋 Welcome to your AI assistant. How can I help you today?";
    }

    if (text.includes("your name") || text.includes("who are you")) {
        return "I'm your AI Chatbot Assistant, a demo chatbot built using HTML, CSS and JavaScript. 🤖";
    }

    if (text.includes("python")) {
        return `Python is a beginner-friendly programming language.

Important concepts:
1. Variables – Store information.
2. Data types – int, float, string and boolean.
3. Conditions – if, elif and else.
4. Loops – for and while.
5. Functions – Reusable blocks of code.

Example:

name = "Student"
print("Hello", name)

Output:
Hello Student`;
    }

    if (text.includes("javascript") || text.includes("html") || text.includes("css")) {
        return `Web development uses three main technologies:

HTML – Creates the structure of a webpage.
CSS – Adds colors, layouts and design.
JavaScript – Adds functionality and interactivity.

Together, they can create websites, dashboards, games and chatbot interfaces!`;
    }

    if (text.includes("study") || text.includes("timetable")) {
        return `Here is a simple study timetable:

7:00 AM – Revise yesterday's topics
9:00 AM – Study Subject 1
11:00 AM – Practice problems
2:00 PM – Study Subject 2
4:00 PM – Complete assignments
7:00 PM – Revision
9:00 PM – Quick self-test

Tip: Take a short break after every 45–50 minutes.`;
    }

    if (text.includes("english")) {
        return `Here are 5 ways to improve English speaking:

1. Speak English for 10 minutes daily.
2. Learn 5 new words every day.
3. Watch English videos with subtitles.
4. Practice conversations with friends.
5. Record yourself and listen.

Consistency is more important than perfection!`;
    }

    if (text.includes("project") || text.includes("ideas")) {
        return `Here are 5 useful mini-project ideas:

1. Student Attendance Management System
2. Expense Tracker Dashboard
3. AI Chatbot Interface
4. Online Quiz Application
5. Library Management System

You can build these using HTML, CSS, JavaScript and localStorage.`;
    }

    if (text.includes("time") || text.includes("date")) {
        return "Your current browser date and time is: " + new Date().toLocaleString();
    }

    if (text.includes("thank")) {
        return "You're welcome! 😊 Feel free to ask me anything else.";
    }

    if (text.includes("help")) {
        return `I can demonstrate answers about:

💻 Programming and coding
📚 Study planning
💡 Project ideas
🗣️ English learning
🌐 Web development

Try asking me a question!`;
    }

    if (text.includes("joke")) {
        return "Why do programmers prefer dark mode? Because light attracts bugs! 😂";
    }

    if (text.includes("bye")) {
        return "Goodbye! 👋 Have a great day. Come back whenever you need help!";
    }

    return `That's an interesting question! 😊

I'm currently running in demo mode, so I can answer a limited set of common topics.

Try asking about:
• Python programming
• JavaScript, HTML or CSS
• Study timetables
• Project ideas
• English speaking

For real AI-generated answers to any question, connect this interface to an AI API through a secure backend.`;
}

// ----------------------------------
// TYPING ANIMATION
// ----------------------------------

function showTyping() {
    isTyping = true;
    document.getElementById("typing").hidden = false;
    document.getElementById("sendBtn").disabled = true;
    scrollToBottom();
}

function hideTyping() {
    isTyping = false;
    document.getElementById("typing").hidden = true;
    document.getElementById("sendBtn").disabled = false;
}

// ----------------------------------
// COPY MESSAGE
// ----------------------------------

async function copyMessage(text) {
    try {
        await navigator.clipboard.writeText(text);
        alert("Message copied!");
    } catch (error) {
        const temp = document.createElement("textarea");
        temp.value = text;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand("copy");
        temp.remove();
        alert("Message copied!");
    }
}

// ----------------------------------
// DARK / LIGHT MODE
// ----------------------------------

function toggleTheme() {
    document.body.classList.toggle("dark");

    const dark = document.body.classList.contains("dark");

    localStorage.setItem("chatTheme", dark ? "dark" : "light");

    document.querySelector(".top-actions button").textContent =
        dark ? "☀️" : "🌙";
}

function loadTheme() {
    if (localStorage.getItem("chatTheme") === "dark") {
        document.body.classList.add("dark");
        document.querySelector(".top-actions button").textContent = "☀️";
    }
}

// ----------------------------------
// SCROLL AND SAFE TEXT
// ----------------------------------

function scrollToBottom() {
    const area = document.getElementById("chatArea");
    area.scrollTop = area.scrollHeight;
}

function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[c]);
}

// ----------------------------------
// INITIALIZE
// ----------------------------------

function renderAll() {
    renderHistory();
    renderMessages();
}

function initialize() {
    if (chats.length > 0) {
        activeChatId = chats[0].id;
    }

    loadTheme();
    renderAll();
}

initialize();

</script>

</body>
</html>
