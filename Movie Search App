<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Search App</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            min-height: 100vh;
            background: #1c1c1c;
            color: white;
        }

        .container {
            width: 90%;
            max-width: 800px;
            margin: auto;
            padding: 40px 0;
            text-align: center;
        }

        h1 {
            color: #f5c518;
        }

        .search-box {
            display: flex;
            gap: 10px;
            margin: 25px 0;
        }

        input {
            flex: 1;
            padding: 14px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
        }

        button {
            padding: 14px 20px;
            border: none;
            border-radius: 8px;
            background: #f5c518;
            color: black;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #d9ad00;
        }

        #movie {
            background: #292929;
            padding: 25px;
            border-radius: 15px;
            margin-top: 20px;
        }

        #movie img {
            width: 220px;
            max-width: 100%;
            border-radius: 10px;
        }

        .info {
            text-align: left;
            margin-top: 20px;
            line-height: 1.7;
        }

        .error {
            color: #ff6b6b;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>🎬 Movie Search App</h1>

        <p>Search for your favorite movie</p>

        <div class="search-box">

            <input
                type="text"
                id="movieName"
                placeholder="Enter movie name..."
            >

            <button onclick="searchMovie()">
                Search
            </button>

        </div>

        <div id="movie">
            Search for a movie to see its details.
        </div>

    </div>


    <script>

        async function searchMovie() {

            let movieName =
                document.getElementById("movieName").value;

            let movieDiv =
                document.getElementById("movie");


            if (movieName.trim() === "") {

                movieDiv.innerHTML =
                    "<p class='error'>Please enter a movie name.</p>";

                return;
            }


            movieDiv.innerHTML =
                "<p>🔎 Searching...</p>";


            try {

                /*
                    Replace YOUR_API_KEY
                    with your OMDb API key.
                */

                let apiKey = "YOUR_API_KEY";

                let url =
                    `https://www.omdbapi.com/?apikey=${apiKey}&t=${encodeURIComponent(movieName)}`;


                let response = await fetch(url);

                let data = await response.json();


                if (data.Response === "False") {

                    movieDiv.innerHTML =
                        `<p class="error">
                            ❌ Movie not found.
                        </p>`;

                    return;
                }


                movieDiv.innerHTML = `

                    <img
                        src="${data.Poster !== "N/A"
                            ? data.Poster
                            : "https://via.placeholder.com/220x320?text=No+Poster"}"
                        alt="${data.Title}"
                    >

                    <div class="info">

                        <h2>${data.Title}</h2>

                        <p>
                            ⭐ <strong>IMDB Rating:</strong>
                            ${data.imdbRating}
                        </p>

                        <p>
                            📅 <strong>Year:</strong>
                            ${data.Year}
                        </p>

                        <p>
                            🎭 <strong>Genre:</strong>
                            ${data.Genre}
                        </p>

                        <p>
                            🎬 <strong>Director:</strong>
                            ${data.Director}
                        </p>

                        <p>
                            👥 <strong>Actors:</strong>
                            ${data.Actors}
                        </p>

                        <p>
                            🌎 <strong>Language:</strong>
                            ${data.Language}
                        </p>

                        <p>
                            📝 <strong>Plot:</strong>
                            ${data.Plot}
                        </p>

                    </div>
                `;

            }

            catch (error) {

                movieDiv.innerHTML =
                    `<p class="error">
                        ⚠️ Something went wrong. Please try again.
                    </p>`;

            }

        }

    </script>

</body>
</html>
