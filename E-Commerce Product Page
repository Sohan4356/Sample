<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce Product Page</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f5f5;
            padding: 40px;
        }

        .product-container {
            max-width: 1000px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            display: flex;
            gap: 50px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .product-image {
            flex: 1;
            text-align: center;
        }

        .product-image img {
            width: 100%;
            max-width: 400px;
            height: 400px;
            object-fit: cover;
            border-radius: 12px;
        }

        .product-details {
            flex: 1;
            padding: 20px;
        }

        .product-details h1 {
            margin-bottom: 15px;
        }

        .rating {
            color: #f39c12;
            margin-bottom: 15px;
        }

        .price {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .old-price {
            color: #888;
            text-decoration: line-through;
            font-size: 18px;
            margin-left: 10px;
        }

        .description {
            color: #555;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .section {
            margin-bottom: 20px;
        }

        .section h3 {
            margin-bottom: 10px;
        }

        .sizes button {
            padding: 10px 18px;
            margin-right: 8px;
            border: 1px solid #aaa;
            background: white;
            cursor: pointer;
            border-radius: 5px;
        }

        .sizes button.selected {
            background: #222;
            color: white;
        }

        .quantity {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .quantity button {
            width: 35px;
            height: 35px;
            border: none;
            background: #222;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }

        #quantity {
            font-size: 18px;
            font-weight: bold;
        }

        .cart-btn {
            width: 100%;
            padding: 15px;
            border: none;
            background: #ff6b00;
            color: white;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
        }

        .cart-btn:hover {
            background: #e85d00;
        }

        #message {
            margin-top: 15px;
            color: green;
            font-weight: bold;
            text-align: center;
        }

        @media (max-width: 700px) {
            .product-container {
                flex-direction: column;
                padding: 20px;
            }

            body {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <div class="product-container">

        <!-- Product Image -->
        <div class="product-image">
            <img
                src="https://picsum.photos/500/500?random=20"
                alt="Product Image"
            >
        </div>

        <!-- Product Details -->
        <div class="product-details">

            <h1>Premium Casual Sneakers</h1>

            <div class="rating">
                ⭐⭐⭐⭐⭐ (4.8)
            </div>

            <div class="price">
                ₹2,499
                <span class="old-price">₹3,499</span>
            </div>

            <p class="description">
                Comfortable and stylish sneakers suitable for
                everyday wear, college, travel and casual outings.
            </p>

            <!-- Size -->
            <div class="section">

                <h3>Select Size</h3>

                <div class="sizes">

                    <button onclick="selectSize(this)">7</button>
                    <button onclick="selectSize(this)">8</button>
                    <button onclick="selectSize(this)">9</button>
                    <button onclick="selectSize(this)">10</button>

                </div>

            </div>

            <!-- Quantity -->
            <div class="section">

                <h3>Quantity</h3>

                <div class="quantity">

                    <button onclick="decreaseQuantity()">−</button>

                    <span id="quantity">1</span>

                    <button onclick="increaseQuantity()">+</button>

                </div>

            </div>

            <button class="cart-btn" onclick="addToCart()">
                🛒 Add to Cart
            </button>

            <p id="message"></p>

        </div>

    </div>


    <script>

        let quantity = 1;
        let selectedSize = "";


        function selectSize(button) {

            const buttons =
                document.querySelectorAll(".sizes button");

            buttons.forEach(btn => {
                btn.classList.remove("selected");
            });

            button.classList.add("selected");

            selectedSize = button.textContent;
        }


        function increaseQuantity() {

            quantity++;

            document.getElementById("quantity")
                .textContent = quantity;
        }


        function decreaseQuantity() {

            if (quantity > 1) {
                quantity--;
            }

            document.getElementById("quantity")
                .textContent = quantity;
        }


        function addToCart() {

            const message =
                document.getElementById("message");

            if (selectedSize === "") {

                message.style.color = "red";

                message.textContent =
                    "Please select a size.";

                return;
            }

            message.style.color = "green";

            message.textContent =
                `Added ${quantity} item(s), Size ${selectedSize}, to cart!`;
        }

    </script>

</body>
</html>
