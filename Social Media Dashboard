
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Social Media Dashboard</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #f5f7fb;
    --card: #ffffff;
    --text: #172033;
    --muted: #64748b;
    --border: #e2e8f0;
    --primary: #635bdb;
}

body {
    font-family: Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: background 0.2s, color 0.2s;
}

body.dark {
    --bg: #101827;
    --card: #1c2738;
    --text: #f1f5f9;
    --muted: #a5b4c7;
    --border: #344155;
}

.app {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 235px;
    background: var(--card);
    border-right: 1px solid var(--border);
    padding: 28px 18px;
    flex-shrink: 0;
}

.logo {
    font-size: 21px;
    font-weight: bold;
    color: var(--primary);
    margin-bottom: 38px;
}

.nav-label {
    color: var(--muted);
    font-size: 12px;
    margin: 20px 10px 12px;
    text-transform: uppercase;
}

.nav-link {
    display: block;
    padding: 13px 12px;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 7px;
}

.nav-link.active,
.nav-link:hover {
    background: #eeedff;
    color: #5145cd;
}

main {
    flex: 1;
    min-width: 0;
    padding: 30px;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 28px;
}

.topbar h1 {
    font-size: 27px;
    margin-bottom: 7px;
}

.subtitle {
    color: var(--muted);
    font-size: 14px;
}

.actions {
    display: flex;
    gap: 10px;
    align-items: center;
}

select, button {
    padding: 11px 13px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    color: var(--text);
    cursor: pointer;
    font-size: 14px;
}

button:hover {
    opacity: 0.85;
}

.metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 25px;
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 21px;
    min-width: 0;
}

.metric-label {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 17px;
}

.metric-value {
    font-size: clamp(22px, 2vw, 29px);
    font-weight: bold;
    margin-bottom: 10px;
}

.growth {
    color: #16a34a;
    font-size: 13px;
}

.middle-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(250px, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}

.card-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
}

.card-heading h2 {
    font-size: 18px;
}

.chart-legend {
    color: var(--muted);
    font-size: 12px;
}

.chart {
    height: 235px;
    display: flex;
    align-items: end;
    gap: 12px;
    padding: 15px 5px 0;
    border-bottom: 1px solid var(--border);
    background: repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 56px,
        var(--border) 57px,
        transparent 58px
    );
}

.bar-group {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: end;
    justify-content: center;
    gap: 4px;
    position: relative;
}

.bar {
    width: 35%;
    max-width: 28px;
    min-height: 4px;
    border-radius: 5px 5px 0 0;
    background: #8178ee;
    transition: height 0.3s;
}

.bar.secondary {
    background: #c4b5fd;
}

.chart-labels {
    display: flex;
    justify-content: space-around;
    color: var(--muted);
    font-size: 12px;
    padding-top: 10px;
}

.platform {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 19px 0;
}

.platform-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #eeedff;
    font-size: 20px;
}

.platform-info {
    flex: 1;
    min-width: 0;
}

.platform-info strong {
    display: block;
    margin-bottom: 5px;
}

.platform-info span {
    color: var(--muted);
    font-size: 12px;
}

.platform-number {
    font-weight: bold;
}

.table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 510px;
}

th, td {
    padding: 15px 10px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
}

th {
    color: var(--muted);
    font-weight: normal;
}

.status {
    color: #16a34a;
    background: #dcfce7;
    padding: 6px 9px;
    border-radius: 20px;
    font-size: 12px;
}

footer {
    text-align: center;
    color: var(--muted);
    padding: 25px 0 0;
    font-size: 13px;
}

@media (max-width: 1100px) {
    .metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .middle-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    .sidebar {
        width: 65px;
        padding: 20px 8px;
    }

    .logo {
        font-size: 0;
        text-align: center;
    }

    .logo::after {
        content: "📊";
        font-size: 23px;
    }

    .nav-label {
        display: none;
    }

    .nav-link {
        text-align: center;
        font-size: 0;
        padding: 13px 5px;
    }

    .nav-link::first-letter {
        font-size: 19px;
    }

    main {
        padding: 18px 12px;
    }

    .topbar h1 {
        font-size: 23px;
    }

    .metrics {
        gap: 10px;
    }

    .card {
        padding: 14px;
    }

    .metric-value {
        font-size: 22px;
    }
}

@media (max-width: 390px) {
    .metrics {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<div class="app">

    <aside class="sidebar">
        <div class="logo">SocialPulse</div>

        <p class="nav-label">Workspace</p>

        <a class="nav-link active" href="#overview">🏠 Overview</a>
        <a class="nav-link" href="#analytics">📈 Analytics</a>
        <a class="nav-link" href="#platforms">🌐 Platforms</a>
        <a class="nav-link" href="#posts">📝 Posts</a>

        <p class="nav-label">Account</p>
        <a class="nav-link" href="#settings">⚙️ Settings</a>
    </aside>

    <main id="overview">

        <div class="topbar">
            <div>
                <h1>Social Media Dashboard</h1>
                <p class="subtitle">Track your social media performance</p>
            </div>

            <div class="actions">
                <select id="period" aria-label="Select date range">
                    <option value="7">Last 7 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="90">Last 90 days</option>
                </select>

                <button id="themeButton">🌙 Theme</button>
            </div>
        </div>

        <section class="metrics" aria-label="Social media metrics">

            <article class="card">
                <p class="metric-label">👥 Total Followers</p>
                <p class="metric-value" id="followers">24.8K</p>
                <p class="growth">↑ 12.5% this period</p>
            </article>

            <article class="card">
                <p class="metric-label">❤️ Total Likes</p>
                <p class="metric-value" id="likes">18.2K</p>
                <p class="growth">↑ 8.3% this period</p>
            </article>

            <article class="card">
                <p class="metric-label">👁️ Total Reach</p>
                <p class="metric-value" id="reach">142K</p>
                <p class="growth">↑ 15.7% this period</p>
            </article>

            <article class="card">
                <p class="metric-label">💬 Engagement Rate</p>
                <p class="metric-value" id="engagement">6.8%</p>
                <p class="growth">↑ 2.1% this period</p>
            </article>

        </section>

        <section class="middle-grid">

            <article class="card" id="analytics">
                <div class="card-heading">
                    <h2>Performance Overview</h2>
                    <span class="chart-legend">Reach by day</span>
                </div>

                <div class="chart" id="chart" role="img"
                     aria-label="Bar chart showing social media reach by day">
                </div>

                <div class="chart-labels" id="chartLabels"></div>
            </article>

            <article class="card" id="platforms">
                <div class="card-heading">
                    <h2>Platform Overview</h2>
                </div>

                <div class="platform">
                    <div class="platform-icon">📸</div>
                    <div class="platform-info">
                        <strong>Instagram</strong>
                        <span>Followers</span>
                    </div>
                    <div class="platform-number">12.5K</div>
                </div>

                <div class="platform">
                    <div class="platform-icon">▶️</div>
                    <div class="platform-info">
                        <strong>YouTube</strong>
                        <span>Subscribers</span>
                    </div>
                    <div class="platform-number">7.2K</div>
                </div>

                <div class="platform">
                    <div class="platform-icon">𝕏</div>
                    <div class="platform-info">
                        <strong>X</strong>
                        <span>Followers</span>
                    </div>
                    <div class="platform-number">3.1K</div>
                </div>

                <div class="platform">
                    <div class="platform-icon">f</div>
                    <div class="platform-info">
                        <strong>Facebook</strong>
                        <span>Followers</span>
                    </div>
                    <div class="platform-number">2.0K</div>
                </div>
            </article>

        </section>

        <section class="card" id="posts">
            <div class="card-heading">
                <h2>Recent Posts</h2>

                <select id="platformFilter" aria-label="Filter posts by platform">
                    <option value="All">All Platforms</option>
                    <option value="Instagram">Instagram</option>
                    <option value="YouTube">YouTube</option>
                    <option value="X">X</option>
                    <option value="Facebook">Facebook</option>
                </select>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Post</th>
                            <th>Platform</th>
                            <th>Likes</th>
                            <th>Comments</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="postTable"></tbody>
                </table>
            </div>
        </section>

        <section class="card" id="settings" style="margin-top: 25px;">
            <div class="card-heading">
                <h2>Quick Actions</h2>
            </div>
            <p class="subtitle" style="margin-bottom: 15px;">
                Refresh the sample dashboard figures.
            </p>
            <button id="refreshButton">↻ Refresh Demo Data</button>
            <p id="refreshMessage" class="subtitle"
               style="margin-top: 12px;" aria-live="polite"></p>
        </section>

        <footer>
            SocialPulse Dashboard · Built with HTML, CSS & JavaScript
        </footer>

    </main>
</div>

<script>
const posts = [
    {
        title: "Summer Campaign",
        platform: "Instagram",
        likes: 2450,
        comments: 180
    },
    {
        title: "JavaScript Tutorial",
        platform: "YouTube",
        likes: 1830,
        comments: 95
    },
    {
        title: "New Product Update",
        platform: "X",
        likes: 920,
        comments: 76
    },
    {
        title: "Community Highlights",
        platform: "Facebook",
        likes: 1250,
        comments: 110
    },
    {
        title: "Behind the Scenes",
        platform: "Instagram",
        likes: 3120,
        comments: 240
    }
];

function formatNumber(number) {
    return number >= 1000
        ? (number / 1000).toFixed(1).replace(".0", "") + "K"
        : String(number);
}

function renderPosts() {
    const selected = document.getElementById("platformFilter").value;
    const table = document.getElementById("postTable");

    table.replaceChildren();

    const filteredPosts = posts.filter(post =>
        selected === "All" || post.platform === selected
    );

    if (filteredPosts.length === 0) {
        const row = document.createElement("tr");
        const cell = document.createElement("td");

        cell.colSpan = 5;
        cell.textContent = "No posts found for this platform.";
        row.appendChild(cell);
        table.appendChild(row);
        return;
    }

    filteredPosts.forEach(post => {
        const row = document.createElement("tr");

        [
            post.title,
            post.platform,
            formatNumber(post.likes),
            post.comments.toLocaleString()
        ].forEach(value => {
            const cell = document.createElement("td");
            cell.textContent = value;
            row.appendChild(cell);
        });

        const statusCell = document.createElement("td");
        const status = document.createElement("span");

        status.className = "status";
        status.textContent = "Published";

        statusCell.appendChild(status);
        row.appendChild(statusCell);
        table.appendChild(row);
    });
}

function renderChart(days) {
    const chart = document.getElementById("chart");
    const labels = document.getElementById("chartLabels");

    chart.replaceChildren();
    labels.replaceChildren();

    const numberOfBars = 7;
    const values = Array.from({ length: numberOfBars }, (_, i) => {
        const trend = 35 + i * 6;
        return Math.min(95, trend + Math.floor(Math.random() * 20));
    });

    values.forEach((value, i) => {
        const group = document.createElement("div");
        group.className = "bar-group";

        const bar1 = document.createElement("div");
        bar1.className = "bar";
        bar1.style.height = value + "%";
        bar1.title = `Reach: ${value * 100} (sample)`;

        const bar2 = document.createElement("div");
        bar2.className = "bar secondary";
        bar2.style.height = Math.max(5, value * 0.65) + "%";
        bar2.title = `Previous period: ${Math.round(value * 65)} (sample)`;

        group.append(bar1, bar2);
        chart.appendChild(group);

        const label = document.createElement("span");
        label.textContent = days === 7
            ? ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][i]
            : `Day ${i + 1}`;

        labels.appendChild(label);
    });
}

function updatePeriod() {
    const days = Number(document.getElementById("period").value);

    const multiplier = days === 7 ? 1 : days === 30 ? 3.2 : 7.5;

    document.getElementById("followers").textContent =
        formatNumber(Math.round(24800 * multiplier));

    document.getElementById("likes").textContent =
        formatNumber(Math.round(18200 * multiplier));

    document.getElementById("reach").textContent =
        formatNumber(Math.round(142000 * multiplier));

    document.getElementById("engagement").textContent =
        days === 7 ? "6.8%" : days === 30 ? "7.2%" : "7.6%";

    renderChart(days);
}

document.getElementById("period").addEventListener("change", updatePeriod);

document.getElementById("platformFilter").addEventListener(
    "change",
    renderPosts
);

document.getElementById("themeButton").addEventListener("click", () => {
    document.body.classList.toggle("dark");

    document.getElementById("themeButton").textContent =
        document.body.classList.contains("dark")
            ? "☀️ Theme"
            : "🌙 Theme";
});

document.getElementById("refreshButton").addEventListener("click", () => {
    // Refresh only the demonstration chart.
    renderChart(Number(document.getElementById("period").value));

    document.getElementById("refreshMessage").textContent =
        "Demo chart refreshed successfully.";
});

document.querySelectorAll(".nav-link").forEach(link => {
    link.addEventListener("click", () => {
        document.querySelectorAll(".nav-link").forEach(item =>
            item.classList.remove("active")
        );

        link.classList.add("active");
    });
});

renderPosts();
updatePeriod();
</script>

</body>
</html>
