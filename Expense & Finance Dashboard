// RENDER ALL
// --------------------------------------

function renderAll() {
    renderSummary();
    renderTransactions();
    renderBudget();
    renderCategorySummary();
    drawBarChart();
    drawPieChart();
}

function initialize() {
    document.getElementById("todayText").textContent =
        new Date().toLocaleDateString("en-IN", {
            day: "numeric",
            month: "short",
            year: "numeric"
        });

    setupMonthFilter();
    renderAll();
}

let resizeTimer;

window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
        drawBarChart();
        drawPieChart();
    }, 120);
});

initialize();

</script>
