
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Expense & Finance Dashboard</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6fb;
    color: #202638;
}

header {
    background: #17243a;
    color: white;
    padding: 22px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

header h1 { font-size: 25px; }
header p { color: #b9c5d8; margin-top: 6px; }

.container {
    width: 92%;
    max-width: 1250px;
    margin: 25px auto;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 22px;
}

.topbar select {
    width: auto;
    min-width: 160px;
}

input, select {
    padding: 11px;
    border: 1px solid #dce1eb;
    border-radius: 7px;
    background: white;
    outline: none;
}

input:focus, select:focus { border-color: #566ee8; }

.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 17px;
    margin-bottom: 22px;
}

.stat-card {
    padding: 21px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 3px 12px #17243a0b;
    border-top: 4px solid #566ee8;
}

.stat-card small { color: #778096; font-size: 13px; }
.stat-card h2 { margin-top: 12px; font-size: 27px; }
.stat-card p { margin-top: 8px; font-size: 12px; color: #7b8497; }

.income { border-color: #16a875; }
.expense { border-color: #e45c65; }
.balance { border-color: #566ee8; }
.savings { border-color: #e4a52e; }

.income h2 { color: #16a875; }
.expense h2 { color: #e45c65; }
.balance h2 { color: #566ee8; }
.savings h2 { color: #d49219; }

.grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
    margin-bottom: 22px;
}

.panel {
    background: white;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #17243a0b;
    margin-bottom: 20px;
    min-width: 0;
}

.panel h3 {
    margin-bottom: 18px;
    color: #26344c;
}

.chart-box {
    height: 280px;
    position: relative;
    width: 100%;
}

canvas {
    width: 100%;
    height: 100%;
    display: block;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
}

.form-group label {
    display: block;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 5px;
}

.form-group input,
.form-group select {
    width: 100%;
}

.btn {
    background: #566ee8;
    color: white;
    padding: 11px 18px;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
    margin-top: 15px;
}

.btn:hover { opacity: .85; }

.delete-btn {
    background: #ffe7e9;
    color: #d34350;
    border: none;
    border-radius: 5px;
    padding: 7px 10px;
    cursor: pointer;
}

.toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
}

.toolbar input { flex: 1; min-width: 180px; }

.table-wrap { overflow-x: auto; }

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

th, td {
    padding: 13px 10px;
    text-align: left;
    border-bottom: 1px solid #edf0f5;
    font-size: 13px;
}

th {
    color: #758096;
    background: #f8f9fc;
}

.type {
    font-weight: bold;
}

.type.in { color: #16a875; }
.type.out { color: #e45c65; }

.budget-item { margin-bottom: 20px; }

.budget-head {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
    margin-bottom: 8px;
}

.progress {
    height: 9px;
    background: #edf0f5;
    border-radius: 20px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: #566ee8;
    border-radius: 20px;
    transition: width .3s;
}

.progress-fill.warning { background: #e4a52e; }
.progress-fill.danger { background: #e45c65; }

.category-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #edf0f5;
    font-size: 13px;
}

.empty {
    text-align: center;
    padding: 25px;
    color: #8992a4;
}

footer {
    text-align: center;
    color: #8992a4;
    padding: 25px;
    font-size: 13px;
}

@media(max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
}

@media(max-width: 500px) {
    .container { width: 95%; }
    .panel { padding: 15px; }
    header h1 { font-size: 21px; }
}
</style>
</head>

<body>

<header>
    <div>
        <h1>💰 Finance Dashboard</h1>
        <p>Track your money. Manage your future.</p>
    </div>
    <div id="todayText"></div>
</header>

<div class="container">

    <div class="topbar">
        <div>
            <h2>Overview</h2>
            <p style="color:#8992a4;font-size:13px;margin-top:5px">
                Your personal financial summary
            </p>
        </div>

        <select id="monthFilter" onchange="renderAll()">
        </select>
    </div>

    <!-- SUMMARY CARDS -->
    <section class="stats">

        <div class="stat-card income">
            <small>Total Income</small>
            <h2 id="totalIncome">₹0</h2>
            <p>Money received this month</p>
        </div>

        <div class="stat-card expense">
            <small>Total Expenses</small>
            <h2 id="totalExpense">₹0</h2>
            <p>Money spent this month</p>
        </div>

        <div class="stat-card balance">
            <small>Remaining Balance</small>
            <h2 id="totalBalance">₹0</h2>
            <p>Income minus expenses</p>
        </div>

        <div class="stat-card savings">
            <small>Savings Rate</small>
            <h2 id="savingsRate">0%</h2>
            <p>Percentage of income saved</p>
        </div>

    </section>

    <!-- CHARTS -->
    <section class="grid">

        <div class="panel">
            <h3>Income vs Expenses</h3>
            <div class="chart-box">
                <canvas id="barChart"></canvas>
            </div>
        </div>

        <div class="panel">
            <h3>Expense Breakdown</h3>
            <div class="chart-box">
                <canvas id="pieChart"></canvas>
            </div>
        </div>

    </section>

    <!-- ADD TRANSACTION -->
    <section class="panel">
        <h3>➕ Add New Transaction</h3>

        <form id="transactionForm">

            <div class="form-grid">

                <div class="form-group">
                    <label>Transaction Type</label>
                    <select id="type" required>
                        <option value="income">Income</option>
                        <option value="expense">Expense</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <input id="description" placeholder="e.g. Monthly salary" required>
                </div>

                <div class="form-group">
                    <label>Amount (₹)</label>
                    <input id="amount" type="number" min="0.01" step="0.01" placeholder="Enter amount" required>
                </div>

                <div class="form-group">
                    <label>Category</label>
                    <select id="category" required>
                        <option value="Salary">Salary</option>
                        <option value="Freelance">Freelance</option>
                        <option value="Food">Food</option>
                        <option value="Shopping">Shopping</option>
                        <option value="Transport">Transport</option>
                        <option value="Education">Education</option>
                        <option value="Bills">Bills</option>
                        <option value="Entertainment">Entertainment</option>
                        <option value="Health">Health</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Date</label>
                    <input id="date" type="date" required>
                </div>

            </div>

            <button class="btn" type="submit">Add Transaction</button>
            <p id="formMessage" style="font-size:13px;margin-top:10px"></p>

        </form>
    </section>

    <!-- BUDGET -->
    <section class="grid">

        <div class="panel">
            <h3>🎯 Monthly Budget</h3>

            <div class="form-group">
                <label>Set Monthly Expense Budget (₹)</label>
                <input id="budgetInput" type="number" min="1" placeholder="Enter budget">
            </div>

            <button class="btn" onclick="saveBudget()">Save Budget</button>

            <div style="margin-top:22px">
                <div class="budget-head">
                    <strong>Budget Used</strong>
                    <span id="budgetPercent">0%</span>
                </div>

                <div class="progress">
                    <div class="progress-fill" id="budgetBar" style="width:0%"></div>
                </div>

                <p id="budgetText" style="font-size:13px;color:#8992a4;margin-top:10px">
                    Set a budget to start tracking.
                </p>
            </div>
        </div>

        <div class="panel">
            <h3>📊 Category Summary</h3>
            <div id="categorySummary"></div>
        </div>

    </section>

    <!-- TRANSACTIONS -->
    <section class="panel">
        <h3>Recent Transactions</h3>

        <div class="toolbar">
            <input id="searchInput" placeholder="Search transactions..." oninput="renderTransactions()">

            <select id="typeFilter" onchange="renderTransactions()">
                <option value="">All Types</option>
                <option value="income">Income</option>
                <option value="expense">Expense</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="transactionTable"></tbody>
            </table>
        </div>
    </section>

</div>

<footer>
    Expense & Finance Dashboard | Built with HTML, CSS and JavaScript
</footer>

<script>

// --------------------------------------
// DATA AND LOCAL STORAGE
// --------------------------------------

const STORAGE_KEY = "financeDashboard_v1";

const defaultData = {
    transactions: [
        { id: 1, description: "Monthly Salary", amount: 30000, type: "income", category: "Salary", date: todayString() },
        { id: 2, description: "Freelance Project", amount: 5000, type: "income", category: "Freelance", date: todayString() },
        { id: 3, description: "Grocery Shopping", amount: 2500, type: "expense", category: "Food", date: todayString() },
        { id: 4, description: "College Fees", amount: 4000, type: "expense", category: "Education", date: todayString() },
        { id: 5, description: "Bus Travel", amount: 800, type: "expense", category: "Transport", date: todayString() },
        { id: 6, description: "Movie Night", amount: 500, type: "expense", category: "Entertainment", date: todayString() }
    ],
    budgets: {}
};

function todayString() {
    const d = new Date();
    const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
    return local.toISOString().slice(0, 10);
}

function loadData() {
    try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
            const parsed = JSON.parse(saved);
            if (Array.isArray(parsed.transactions) && parsed.budgets) {
                return parsed;
            }
        }
    } catch (error) {
        console.error("Could not load finance data:", error);
    }

    return JSON.parse(JSON.stringify(defaultData));
}

let data = loadData();

function saveData() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        return true;
    } catch (error) {
        alert("Could not save data. Browser storage may be unavailable.");
        return false;
    }
}

// --------------------------------------
// HELPERS
// --------------------------------------

const money = amount => "₹" + Number(amount).toLocaleString("en-IN", {
    maximumFractionDigits: 2
});

function currentMonth() {
    return todayString().slice(0, 7);
}

function getSelectedMonth() {
    return document.getElementById("monthFilter").value;
}

function getMonthTransactions() {
    const month = getSelectedMonth();

    return data.transactions.filter(t =>
        t.date.startsWith(month)
    );
}

function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[c]);
}

function formatDate(date) {
    return new Date(date + "T12:00:00").toLocaleDateString("en-IN");
}

// --------------------------------------
// MONTH FILTER
// --------------------------------------

function setupMonthFilter() {
    const select = document.getElementById("monthFilter");
    const existing = select.value;

    const months = new Set([currentMonth()]);

    data.transactions.forEach(t => months.add(t.date.slice(0, 7)));

    const sorted = [...months].sort().reverse();

    select.innerHTML = sorted.map(month => {
        const [year, m] = month.split("-");
        const label = new Date(Number(year), Number(m) - 1, 1)
            .toLocaleDateString("en-IN", {
                month: "long",
                year: "numeric"
            });

        return `<option value="${month}">${label}</option>`;
    }).join("");

    select.value = sorted.includes(existing) ? existing : currentMonth();
}

// --------------------------------------
// DASHBOARD SUMMARY
// --------------------------------------

function renderSummary() {
    const transactions = getMonthTransactions();

    const income = transactions
        .filter(t => t.type === "income")
        .reduce((sum, t) => sum + t.amount, 0);

    const expense = transactions
        .filter(t => t.type === "expense")
        .reduce((sum, t) => sum + t.amount, 0);

    const balance = income - expense;
    const savings = income > 0 ? (balance / income) * 100 : 0;

    document.getElementById("totalIncome").textContent = money(income);
    document.getElementById("totalExpense").textContent = money(expense);
    document.getElementById("totalBalance").textContent = money(balance);
    document.getElementById("savingsRate").textContent =
        income > 0 ? savings.toFixed(1) + "%" : "0%";
}

// --------------------------------------
// ADD TRANSACTION
// --------------------------------------

document.getElementById("date").value = todayString();

document.getElementById("transactionForm").addEventListener("submit", function(e) {
    e.preventDefault();

    const description = document.getElementById("description").value.trim();
    const amount = Number(document.getElementById("amount").value);
    const type = document.getElementById("type").value;
    const category = document.getElementById("category").value;
    const date = document.getElementById("date").value;

    if (!description || !Number.isFinite(amount) || amount <= 0 || !date) {
        showMessage("Please enter valid transaction details.", false);
        return;
    }

    const transaction = {
        id: Date.now(),
        description,
        amount,
        type,
        category,
        date
    };

    data.transactions.push(transaction);

    if (!saveData()) {
        data.transactions.pop();
        return;
    }

    this.reset();
    document.getElementById("date").value = todayString();

    document.getElementById("monthFilter").value = date.slice(0, 7);

    showMessage("Transaction added successfully!", true);
    renderAll();
});

function showMessage(message, success) {
    const element = document.getElementById("formMessage");
    element.textContent = message;
    element.style.color = success ? "#16a875" : "#e45c65";
}

// --------------------------------------
// DELETE TRANSACTION
// --------------------------------------

function deleteTransaction(id) {
    if (!confirm("Are you sure you want to delete this transaction?")) {
        return;
    }

    const index = data.transactions.findIndex(t => t.id === Number(id));
    if (index === -1) return;

    const removed = data.transactions.splice(index, 1)[0];

    if (!saveData()) {
        data.transactions.splice(index, 0, removed);
        return;
    }

    renderAll();
}

// --------------------------------------
// TRANSACTION TABLE
// --------------------------------------

function renderTransactions() {
    const search = document.getElementById("searchInput").value.toLowerCase();
    const typeFilter = document.getElementById("typeFilter").value;

    const transactions = getMonthTransactions()
        .filter(t => {
            const matchesSearch =
                t.description.toLowerCase().includes(search) ||
                t.category.toLowerCase().includes(search);

            const matchesType = !typeFilter || t.type === typeFilter;

            return matchesSearch && matchesType;
        })
        .sort((a, b) => b.date.localeCompare(a.date) || b.id - a.id);

    document.getElementById("transactionTable").innerHTML =
        transactions.length ? transactions.map(t => `
            <tr>
                <td>${escapeHTML(t.description)}</td>
                <td>${escapeHTML(t.category)}</td>
                <td>${formatDate(t.date)}</td>
                <td>
                    <span class="type ${t.type === "income" ? "in" : "out"}">
                        ${t.type === "income" ? "Income" : "Expense"}
                    </span>
                </td>
                <td style="font-weight:bold;color:${t.type === "income" ? "#16a875" : "#e45c65"}">
                    ${t.type === "income" ? "+" : "-"}${money(t.amount)}
                </td>
                <td>
                    <button class="delete-btn" onclick="deleteTransaction(${t.id})">Delete</button>
                </td>
            </tr>
        `).join("") :
        `<tr><td colspan="6" class="empty">No transactions found.</td></tr>`;
}

// --------------------------------------
// BUDGET TRACKER
// --------------------------------------

function saveBudget() {
    const amount = Number(document.getElementById("budgetInput").value);
    const month = getSelectedMonth();

    if (!Number.isFinite(amount) || amount <= 0) {
        alert("Please enter a valid budget amount.");
        return;
    }

    const oldValue = data.budgets[month];
    data.budgets[month] = amount;

    if (!saveData()) {
        if (oldValue === undefined) delete data.budgets[month];
        else data.budgets[month] = oldValue;
        return;
    }

    renderBudget();
    alert("Monthly budget saved!");
}

function renderBudget() {
    const month = getSelectedMonth();
    const budget = Number(data.budgets[month]) || 0;

    const expense = getMonthTransactions()
        .filter(t => t.type === "expense")
        .reduce((sum, t) => sum + t.amount, 0);

    document.getElementById("budgetInput").value = budget || "";

    const percent = budget > 0 ? (expense / budget) * 100 : 0;
    const capped = Math.min(percent, 100);

    const bar = document.getElementById("budgetBar");

    bar.style.width = capped + "%";
    bar.className = "progress-fill";

    if (percent >= 100) bar.classList.add("danger");
    else if (percent >= 80) bar.classList.add("warning");

    document.getElementById("budgetPercent").textContent =
        budget > 0 ? percent.toFixed(1) + "%" : "0%";

    document.getElementById("budgetText").textContent =
        budget > 0
            ? `${money(expense)} spent out of ${money(budget)}. ${expense > budget ? "You exceeded your budget by " + money(expense - budget) + "." : money(budget - expense) + " remaining."}`
            : "Set a budget to start tracking.";
}

// --------------------------------------
// CATEGORY SUMMARY
// --------------------------------------

function renderCategorySummary() {
    const transactions = getMonthTransactions()
        .filter(t => t.type === "expense");

    const categories = {};

    transactions.forEach(t => {
        categories[t.category] = (categories[t.category] || 0) + t.amount;
    });

    const sorted = Object.entries(categories)
        .sort((a, b) => b[1] - a[1]);

    document.getElementById("categorySummary").innerHTML =
        sorted.length ? sorted.map(([category, amount]) => `
            <div class="category-row">
                <span>${escapeHTML(category)}</span>
                <strong>${money(amount)}</strong>
            </div>
        `).join("") :
        `<p class="empty">No expenses for this month.</p>`;
}

// --------------------------------------
// CANVAS CHART HELPERS
// --------------------------------------

function setupCanvas(canvas) {
    const rect = canvas.getBoundingClientRect();
    const ratio = window.devicePixelRatio || 1;

    canvas.width = rect.width * ratio;
    canvas.height = rect.height * ratio;

    const ctx = canvas.getContext("2d");
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

    return {
        ctx,
        width: rect.width,
        height: rect.height
    };
}

// --------------------------------------
// BAR CHART
// --------------------------------------

function drawBarChart() {
    const canvas = document.getElementById("barChart");
    const { ctx, width, height } = setupCanvas(canvas);

    ctx.clearRect(0, 0, width, height);

    const transactions = getMonthTransactions();

    const income = transactions
        .filter(t => t.type === "income")
        .reduce((sum, t) => sum + t.amount, 0);

    const expense = transactions
        .filter(t => t.type === "expense")
        .reduce((sum, t) => sum + t.amount, 0);

    const max = Math.max(income, expense, 1) * 1.2;

    const left = 45;
    const bottom = height - 38;
    const chartHeight = height - 75;
    const barWidth = Math.min(75, width * 0.18);

    ctx.font = "11px Arial";
    ctx.fillStyle = "#8992a4";
    ctx.strokeStyle = "#edf0f5";

    for (let i = 0; i <= 4; i++) {
        const y = bottom - chartHeight * i / 4;

        ctx.beginPath();
        ctx.moveTo(left, y);
        ctx.lineTo(width - 10, y);
        ctx.stroke();

        const value = max * i / 4;
        ctx.fillText(
            value >= 1000 ? "₹" + (value / 1000).toFixed(1) + "k" : "₹" + Math.round(value),
            2,
            y - 4
        );
    }

    const positions = [
        { label: "Income", value: income, x: width * 0.35, color: "#16a875" },
        { label: "Expenses", value: expense, x: width * 0.68, color: "#e45c65" }
    ];

    positions.forEach(item => {
        const barHeight = item.value / max * chartHeight;
        const x = item.x - barWidth / 2;
        const y = bottom - barHeight;

        ctx.fillStyle = item.color;
        ctx.beginPath();
        ctx.roundRect(x, y, barWidth, Math.max(barHeight, 2), 6);
        ctx.fill();

        ctx.fillStyle = "#26344c";
        ctx.textAlign = "center";
        ctx.font = "bold 12px Arial";
        ctx.fillText(
            item.value >= 1000
                ? "₹" + (item.value / 1000).toFixed(1) + "k"
                : "₹" + item.value.toFixed(0),
            item.x,
            Math.max(y - 8, 13)
        );

        ctx.fillStyle = "#778096";
        ctx.font = "12px Arial";
        ctx.fillText(item.label, item.x, bottom + 22);
    });

    ctx.textAlign = "left";
}

// --------------------------------------
// DOUGHNUT CHART
// --------------------------------------

function drawPieChart() {
    const canvas = document.getElementById("pieChart");
    const { ctx, width, height } = setupCanvas(canvas);

    ctx.clearRect(0, 0, width, height);

    const categories = {};

    getMonthTransactions()
        .filter(t => t.type === "expense")
        .forEach(t => {
            categories[t.category] = (categories[t.category] || 0) + t.amount;
        });

    const entries = Object.entries(categories);
    const total = entries.reduce((sum, item) => sum + item[1], 0);

    if (total === 0) {
        ctx.fillStyle = "#8992a4";
        ctx.font = "14px Arial";
        ctx.textAlign = "center";
        ctx.fillText("No expense data available", width / 2, height / 2);
        return;
    }

    const colors = [
        "#566ee8", "#16a875", "#e45c65",
        "#e4a52e", "#9b65d6", "#38a4b8",
        "#ef8b48", "#76849b"
    ];

    const cx = width * 0.5;
    const cy = height * 0.45;
    const radius = Math.min(width * 0.31, height * 0.36);

    let start = -Math.PI / 2;

    entries.forEach((item, index) => {
        const angle = item[1] / total * Math.PI * 2;

        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, radius, start, start + angle);
        ctx.closePath();
        ctx.fillStyle = colors[index % colors.length];
        ctx.fill();

        start += angle;
    });

    // Center hole
    ctx.beginPath();
    ctx.arc(cx, cy, radius * 0.58, 0, Math.PI * 2);
    ctx.fillStyle = "white";
    ctx.fill();

    ctx.fillStyle = "#26344c";
    ctx.textAlign = "center";
    ctx.font = "bold 15px Arial";
    ctx.fillText(money(total), cx, cy + 5);

    // Legend
    const legendY = height - 30;
    const maxItems = Math.min(entries.length, 3);
    const startX = Math.max(8, width / 2 - maxItems * 55);

    entries.slice(0, maxItems).forEach((item, index) => {
        const x = startX + index * 110;

        ctx.fillStyle = colors[index % colors.length];
        ctx.fillRect(x, legendY, 9, 9);

        ctx.fillStyle = "#778096";
        ctx.font = "10px Arial";
        ctx.textAlign = "left";

        const label = item[0].length > 11
            ? item[0].slice(0, 10) + "…"
            : item[0];

        ctx.fillText(label, x + 13, legendY + 9);
    });
}

