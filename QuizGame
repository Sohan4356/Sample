
import java.util.Scanner;

public class QuizGame {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] questions = {
            "Which language is used for Android development?",
            "What is the brain of a computer?",
            "Which data type stores true or false?",
            "Which keyword creates an object in Java?",
            "What is the correct extension for a Java file?",
            "Which loop executes at least once?",
            "Which symbol ends a Java statement?",
            "Which collection stores unique elements?",
            "Which method is the starting point of a Java program?",
            "Which company originally developed Java?"
        };

        String[][] options = {
            {"A. HTML", "B. Java", "C. CSS", "D. SQL"},
            {"A. RAM", "B. Monitor", "C. CPU", "D. Keyboard"},
            {"A. int", "B. String", "C. double", "D. boolean"},
            {"A. new", "B. class", "C. void", "D. static"},
            {"A. .html", "B. .java", "C. .class", "D. .txt"},
            {"A. for", "B. while", "C. do-while", "D. foreach"},
            {"A. :", "B. ;", "C. ,", "D. ."},
            {"A. ArrayList", "B. Array", "C. HashSet", "D. String"},
            {"A. start()", "B. run()", "C. main()", "D. init()"},
            {"A. Microsoft", "B. Sun Microsystems",
             "C. Apple", "D. IBM"}
        };

        char[] answers = {
            'B', 'C', 'D', 'A', 'B',
            'C', 'B', 'C', 'C', 'B'
        };

        int score = 0;

        System.out.println("================================");
        System.out.println("       JAVA QUIZ GAME");
        System.out.println("================================");

        System.out.print("Enter your name: ");
        String name = sc.nextLine();

        System.out.println("\nWelcome, " + name + "!");
        System.out.println("Each correct answer gives 1 mark.");
        System.out.println("Enter A, B, C, or D.\n");

        for (int i = 0; i < questions.length; i++) {
            System.out.println("--------------------------------");
            System.out.println("Question " + (i + 1) + ": "
                    + questions[i]);

            for (String option : options[i]) {
                System.out.println(option);
            }

            char choice;

            while (true) {
                System.out.print("Your answer: ");
                String input = sc.nextLine().trim();

                if (input.length() == 1) {
                    choice = Character.toUpperCase(input.charAt(0));

                    if (choice >= 'A' && choice <= 'D') {
                        break;
                    }
                }

                System.out.println(
                        "Invalid input! Enter A, B, C, or D."
                );
            }

            if (choice == answers[i]) {
                System.out.println("Correct answer!");
                score++;
            } else {
                System.out.println(
                        "Wrong answer! Correct answer: "
                                + answers[i]
                );
            }
        }

        double percentage =
                (score * 100.0) / questions.length;

        System.out.println("\n================================");
        System.out.println("          QUIZ RESULTS");
        System.out.println("================================");
        System.out.println("Player Name : " + name);
        System.out.println("Total Questions : " + questions.length);
        System.out.println("Correct Answers : " + score);
        System.out.println("Wrong Answers : "
                + (questions.length - score));
        System.out.printf("Percentage : %.2f%%%n", percentage);

        if (percentage >= 90) {
            System.out.println("Grade: Excellent!");
        } else if (percentage >= 70) {
            System.out.println("Grade: Very Good!");
        } else if (percentage >= 50) {
            System.out.println("Grade: Good! Keep practicing.");
        } else {
            System.out.println("Grade: Keep learning and try again!");
        }

        System.out.println("Thank you for playing!");
        sc.close();
    }
}
