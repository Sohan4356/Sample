<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Profile Finder</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f4f4;
            display: flex;
            justify-content: center;
            padding: 50px 20px;
        }

        .container {
            width: 500px;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            text-align: center;
        }

        h1 {
            margin-bottom: 20px;
        }

        .search {
            display: flex;
            gap: 10px;
        }

        input {
            flex: 1;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        button {
            padding: 12px 18px;
            border: none;
            background: #24292e;
            color: white;
            border-radius: 8px;
            cursor: pointer;
        }

        button:hover {
            background: #000;
        }

        #profile {
            margin-top: 25px;
        }

        #profile img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            margin-bottom: 15px;
        }

        .username {
            color: #555;
            margin: 5px 0 15px;
        }

        .bio {
            margin-bottom: 20px;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
            padding: 15px;
            background: #f1f1f1;
            border-radius: 10px;
        }

        .stats div {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .number {
            font-size: 20px;
            font-weight: bold;
        }

        .location {
            margin: 10px 0;
        }

        a {
            color: #0969da;
            text-decoration: none;
        }

        .error {
            color: red;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>🐙 GitHub Profile Finder</h1>

        <div class="search">
            <input
                type="text"
                id="username"
                placeholder="Enter GitHub username"
            >

            <button onclick="findProfile()">Search</button>
        </div>

        <div id="profile"></div>

    </div>

    <script>

        async function findProfile() {

            const username = document.getElementById("username").value.trim();
            const profile = document.getElementById("profile");

            if (username === "") {
                profile.innerHTML =
                    "<p class='error'>Please enter a username.</p>";
                return;
            }

            profile.innerHTML = "<p>Loading...</p>";

            try {

                const response = await fetch(
                    `https://api.github.com/users/${username}`
                );

                if (!response.ok) {
                    throw new Error("User not found");
                }

                const data = await response.json();

                profile.innerHTML = `

                    <img src="${data.avatar_url}" alt="Profile">

                    <h2>${data.name || data.login}</h2>

                    <p class="username">@${data.login}</p>

                    <p class="bio">
                        ${data.bio || "No bio available"}
                    </p>

                    <div class="stats">

                        <div>
                            <span class="number">${data.public_repos}</span>
                            <span>Repositories</span>
                        </div>

                        <div>
                            <span class="number">${data.followers}</span>
                            <span>Followers</span>
                        </div>

                        <div>
                            <span class="number">${data.following}</span>
                            <span>Following</span>
                        </div>

                    </div>

                    <p class="location">
                        📍 ${data.location || "Location not available"}
                    </p>

                    <p>
                        📅 Joined:
                        ${new Date(data.created_at).toLocaleDateString()}
                    </p>

                    <br>

                    <a href="${data.html_url}" target="_blank">
                        View GitHub Profile
                    </a>
                `;

            } catch (error) {

                profile.innerHTML =
                    `<p class="error">❌ ${error.message}</p>`;
            }
        }

    </script>

</body>
</html>
