import java.util.ArrayList;
import java.util.Scanner;

class Vehicle {
    int id;
    String brand;
    String model;
    String type;
    double pricePerDay;
    boolean available;

    Vehicle(int id, String brand, String model,
            String type, double pricePerDay) {

        this.id = id;
        this.brand = brand;
        this.model = model;
        this.type = type;
        this.pricePerDay = pricePerDay;
        this.available = true;
    }

    void display() {
        System.out.println(
            id + " | " + brand + " " + model +
            " | " + type +
            " | ₹" + pricePerDay + "/day" +
            " | " + (available ? "Available" : "Rented")
        );
    }
}

public class VehicleRentalSystem {

    static Scanner sc = new Scanner(System.in);
    static ArrayList<Vehicle> vehicles = new ArrayList<>();

    public static void main(String[] args) {

        // Adding vehicles
        vehicles.add(new Vehicle(1, "Toyota", "Etios",
                "Car", 1500));

        vehicles.add(new Vehicle(2, "Maruti", "Ertiga",
                "Car", 2000));

        vehicles.add(new Vehicle(3, "Royal Enfield", "Hunter",
                "Bike", 800));

        vehicles.add(new Vehicle(4, "Yamaha", "MT-15",
                "Bike", 700));

        vehicles.add(new Vehicle(5, "Hyundai", "Creta",
                "SUV", 2500));

        while (true) {

            System.out.println("\n==============================");
            System.out.println("      VEHICLE RENTAL SYSTEM");
            System.out.println("==============================");
            System.out.println("1. View Vehicles");
            System.out.println("2. Rent Vehicle");
            System.out.println("3. Return Vehicle");
            System.out.println("4. Search Vehicle");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");

            int choice = sc.nextInt();

            switch (choice) {

                case 1:
                    viewVehicles();
                    break;

                case 2:
                    rentVehicle();
                    break;

                case 3:
                    returnVehicle();
                    break;

                case 4:
                    searchVehicle();
                    break;

                case 5:
                    System.out.println(
                        "\nThank you for using Vehicle Rental System!"
                    );
                    sc.close();
                    return;

                default:
                    System.out.println("❌ Invalid choice!");
            }
        }
    }

    // View all vehicles
    static void viewVehicles() {

        System.out.println("\n----------- VEHICLES -----------");

        for (Vehicle v : vehicles) {
            v.display();
        }
    }

    // Rent a vehicle
    static void rentVehicle() {

        System.out.print("\nEnter Vehicle ID: ");
        int id = sc.nextInt();

        Vehicle selected = null;

        for (Vehicle v : vehicles) {

            if (v.id == id) {
                selected = v;
                break;
            }
        }

        if (selected == null) {
            System.out.println("❌ Vehicle not found!");
            return;
        }

        if (!selected.available) {
            System.out.println("❌ Vehicle is already rented!");
            return;
        }

        System.out.print("Enter number of days: ");
        int days = sc.nextInt();

        double total = selected.pricePerDay * days;

        selected.available = false;

        System.out.println("\n✅ Vehicle rented successfully!");
        System.out.println("Vehicle: " +
                selected.brand + " " + selected.model);
        System.out.println("Days: " + days);
        System.out.println("Total Cost: ₹" + total);
    }

    // Return a vehicle
    static void returnVehicle() {

        System.out.print("\nEnter Vehicle ID: ");
        int id = sc.nextInt();

        for (Vehicle v : vehicles) {

            if (v.id == id) {

                if (v.available) {
                    System.out.println(
                        "❌ This vehicle was not rented."
                    );
                } else {
                    v.available = true;
                    System.out.println(
                        "✅ Vehicle returned successfully!"
                    );
                }

                return;
            }
        }

        System.out.println("❌ Vehicle not found!");
    }

    // Search vehicle
    static void searchVehicle() {

        sc.nextLine();

        System.out.print(
            "\nEnter brand, model or type: "
        );

        String keyword = sc.nextLine();

        boolean found = false;

        for (Vehicle v : vehicles) {

            if (v.brand.equalsIgnoreCase(keyword)
                    || v.model.equalsIgnoreCase(keyword)
                    || v.type.equalsIgnoreCase(keyword)) {

                v.display();
                found = true;
            }
        }

        if (!found) {
            System.out.println("❌ No vehicle found!");
        }
    }
}
