<!DOCTYPE html>
<html>
<head>
    <title>Notes App</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            padding: 40px;
            background: #f2f2f2;
        }

        .container {
            max-width: 700px;
            margin: auto;
        }

        h1 {
            text-align: center;
        }

        .note-input {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        }

        input,
        textarea {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
            outline: none;
        }

        textarea {
            height: 120px;
            resize: none;
        }

        button {
            padding: 10px 15px;
            border: none;
            border-radius: 6px;
            background: #2196f3;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background: #1976d2;
        }

        #notes {
            margin-top: 25px;
        }

        .note {
            background: white;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .note h3 {
            margin-top: 0;
        }

        .delete {
            background: red;
            margin-top: 10px;
        }

        .delete:hover {
            background: darkred;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>📝 Notes App</h1>

        <div class="note-input">

            <input
                type="text"
                id="title"
                placeholder="Enter note title"
            >

            <textarea
                id="content"
                placeholder="Write your note here..."
            ></textarea>

            <button onclick="addNote()">Add Note</button>

        </div>

        <div id="notes"></div>

    </div>


    <script>

        function addNote() {

            let title = document.getElementById("title").value;
            let content = document.getElementById("content").value;

            if (title === "" || content === "") {
                alert("Please enter title and note!");
                return;
            }

            let note = document.createElement("div");

            note.className = "note";

            note.innerHTML = `
                <h3>${title}</h3>
                <p>${content}</p>

                <button
                    class="delete"
                    onclick="deleteNote(this)">
                    Delete
                </button>
            `;

            document.getElementById("notes").appendChild(note);

            document.getElementById("title").value = "";
            document.getElementById("content").value = "";
        }


        function deleteNote(button) {

            button.parentElement.remove();

        }

    </script>

</body>
</html>
