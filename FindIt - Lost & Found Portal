
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FindIt - Lost & Found Portal</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f4f6fb;
  color: #20283b;
}

header {
  background: #192642;
  color: white;
  padding: 20px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  color: #5de0bb;
}

nav a {
  color: white;
  text-decoration: none;
  margin-left: 20px;
  font-size: 14px;
}

.hero {
  padding: 55px 7%;
  background: linear-gradient(120deg, #192642, #405b88);
  color: white;
}

.hero h1 {
  font-size: 36px;
  margin-bottom: 12px;
}

.hero p {
  color: #d9e1ef;
  line-height: 1.6;
  max-width: 600px;
}

.container {
  max-width: 1150px;
  margin: 30px auto;
  padding: 0 18px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-top: -5px;
}

.stat-card {
  background: white;
  padding: 22px;
  border-radius: 12px;
  border: 1px solid #e5e9f1;
}

.stat-card p {
  color: #778197;
  font-size: 13px;
}

.stat-card h2 {
  margin-top: 10px;
  font-size: 28px;
}

.section {
  background: white;
  padding: 23px;
  border-radius: 12px;
  margin-top: 25px;
  border: 1px solid #e5e9f1;
}

.section h2 {
  margin-bottom: 7px;
}

.muted {
  color: #7b8498;
  font-size: 13px;
}

button {
  border: none;
  padding: 11px 16px;
  border-radius: 7px;
  cursor: pointer;
  font-weight: bold;
  background: #12a886;
  color: white;
}

button:hover {
  opacity: .85;
}

.primary {
  background: #12a886;
  color: white;
}

.secondary {
  background: #e9edf5;
  color: #283650;
}

.danger {
  background: #e45d68;
  color: white;
}

.filters {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 12px;
  margin-top: 20px;
}

input, select, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #dce1eb;
  border-radius: 7px;
  font-size: 14px;
  outline: none;
  background: white;
  font-family: inherit;
}

input:focus, select:focus, textarea:focus {
  border-color: #12a886;
}

.item-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
  margin-top: 22px;
}

.item-card {
  border: 1px solid #e6eaf1;
  border-radius: 11px;
  padding: 18px;
  background: white;
  transition: .2s;
}

.item-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 7px 20px #17233b12;
}

.item-icon {
  width: 48px;
  height: 48px;
  background: #e9f8f4;
  border-radius: 10px;
  display: grid;
  place-items: center;
  font-size: 25px;
  margin-bottom: 14px;
}

.item-card h3 {
  margin-bottom: 8px;
}

.item-card p {
  font-size: 13px;
  color: #778197;
  margin-top: 7px;
  line-height: 1.5;
}

.tag {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 5px;
  font-size: 11px;
  font-weight: bold;
  margin: 4px 4px 4px 0;
}

.lost {
  background: #fff0e9;
  color: #d36a36;
}

.found {
  background: #e7f8f0;
  color: #168762;
}

.returned {
  background: #e9efff;
  color: #4768bc;
}

.card-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 15px;
}

.card-actions button {
  font-size: 12px;
  padding: 9px 11px;
}

.empty {
  text-align: center;
  padding: 35px;
  color: #818a9d;
  background: #f8f9fc;
  border-radius: 9px;
  margin-top: 20px;
}

.modal {
  position: fixed;
  inset: 0;
  background: #10192dbb;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 15px;
  z-index: 10;
}

.modal-box {
  width: 100%;
  max-width: 550px;
  max-height: 90vh;
  overflow-y: auto;
  background: white;
  border-radius: 13px;
  padding: 25px;
}

.modal-box h2 {
  margin-bottom: 18px;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13px;
}

.form-field label {
  display: block;
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 7px;
}

.full {
  grid-column: 1 / -1;
}

.form-actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}

.hidden {
  display: none !important;
}

.details {
  line-height: 1.9;
  margin-top: 12px;
}

.details strong {
  color: #293752;
}

footer {
  text-align: center;
  padding: 30px;
  color: #7b8498;
  font-size: 13px;
}

@media(max-width:850px) {
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .item-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media(max-width:600px) {
  .hero h1 {
    font-size: 28px;
  }

  .filters, .form-grid {
    grid-template-columns: 1fr;
  }

  .full {
    grid-column: auto;
  }

  .item-grid {
    grid-template-columns: 1fr;
  }

  nav a {
    margin-left: 8px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">🔎 FindIt</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#listings">Listings</a>
    <a href="#report">Report Item</a>
  </nav>
</header>

<section class="hero" id="home">
  <h1>Lost Something? Find It Here.</h1>
  <p>
    A simple lost and found portal where people can report missing
    belongings and help others recover their lost items.
  </p>
</section>

<main class="container">

  <!-- Dashboard -->
  <section class="stats">
    <div class="stat-card">
      <p>Total Listings</p>
      <h2 id="totalCount">0</h2>
    </div>

    <div class="stat-card">
      <p>Lost Items</p>
      <h2 id="lostCount">0</h2>
    </div>

    <div class="stat-card">
      <p>Found Items</p>
      <h2 id="foundCount">0</h2>
    </div>

    <div class="stat-card">
      <p>Returned Items</p>
      <h2 id="returnedCount">0</h2>
    </div>
  </section>

  <!-- Report form -->
  <section class="section" id="report">
    <h2>Report an Item</h2>
    <p class="muted">Help someone recover their belongings.</p>
    <br>
    <button onclick="openForm('Lost')">+ Report Lost Item</button>
    <button onclick="openForm('Found')" class="secondary">
      + Report Found Item
    </button>
  </section>

  <!-- Search and filter -->
  <section class="section" id="listings">
    <h2>Browse Listings</h2>
    <p class="muted">Search and filter reported items.</p>

    <div class="filters">
      <input id="searchInput"
        placeholder="Search item, description or location...">

      <select id="categoryFilter">
        <option value="All">All Categories</option>
        <option>Electronics</option>
        <option>Bags</option>
        <option>Documents</option>
        <option>Accessories</option>
        <option>Clothing</option>
        <option>Others</option>
      </select>

      <select id="statusFilter">
        <option value="All">All Statuses</option>
        <option value="Lost">Lost</option>
        <option value="Found">Found</option>
        <option value="Returned">Returned</option>
      </select>
    </div>

    <div class="item-grid" id="itemGrid"></div>
  </section>

</main>

<!-- Add item modal -->
<div class="modal hidden" id="formModal">
  <div class="modal-box">
    <h2 id="formTitle">Report Item</h2>

    <form id="itemForm">
      <div class="form-grid">

        <div class="form-field full">
          <label>Item Name</label>
          <input id="itemName" required maxlength="60"
            placeholder="Example: Black Wallet">
        </div>

        <div class="form-field">
          <label>Category</label>
          <select id="itemCategory" required>
            <option value="">Select Category</option>
            <option>Electronics</option>
            <option>Bags</option>
            <option>Documents</option>
            <option>Accessories</option>
            <option>Clothing</option>
            <option>Others</option>
          </select>
        </div>

        <div class="form-field">
          <label>Date</label>
          <input type="date" id="itemDate" required>
        </div>

        <div class="form-field full">
          <label>Location</label>
          <input id="itemLocation" required maxlength="100"
            placeholder="Where was it lost or found?">
        </div>

        <div class="form-field full">
          <label>Description</label>
          <textarea id="itemDescription" rows="3" required maxlength="500"
            placeholder="Describe the item..."></textarea>
        </div>

        <div class="form-field">
          <label>Your Name</label>
          <input id="reporterName" required maxlength="60"
            placeholder="Enter your name">
        </div>

        <div class="form-field">
          <label>Contact Number</label>
          <input id="reporterPhone" type="tel" maxlength="10"
            required placeholder="10-digit mobile number">
        </div>

      </div>

      <div class="form-actions">
        <button type="submit">Submit Report</button>
        <button type="button" class="secondary"
          onclick="closeForm()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Details modal -->
<div class="modal hidden" id="detailsModal">
  <div class="modal-box">
    <h2>Item Details</h2>
    <div id="detailsContent"></div>
    <div class="form-actions">
      <button class="secondary" onclick="closeDetails()">Close</button>
    </div>
  </div>
</div>

<footer>
  FindIt Lost & Found Portal | Intermediate Web Development Project
</footer>

<script>

// Sample listings
const sampleItems = [
  {
    id: 1,
    name: "Black Wallet",
    category: "Accessories",
    status: "Lost",
    date: "2026-11-18",
    location: "College Library",
    description: "Black leather wallet with a few cards inside.",
    reporter: "Rahul",
    phone: "9876543210"
  },
  {
    id: 2,
    name: "Wireless Earbuds",
    category: "Electronics",
    status: "Found",
    date: "2026-11-17",
    location: "College Canteen",
    description: "White wireless earbuds found near a table.",
    reporter: "Arjun",
    phone: "9876543211"
  },
  {
    id: 3,
    name: "Blue Backpack",
    category: "Bags",
    status: "Lost",
    date: "2026-11-16",
    location: "Bus Parking Area",
    description: "Blue college backpack with notebooks.",
    reporter: "Kiran",
    phone: "9876543212"
  },
  {
    id: 4,
    name: "Student ID Card",
    category: "Documents",
    status: "Returned",
    date: "2026-11-15",
    location: "Computer Lab",
    description: "Student ID card. The owner has collected it.",
    reporter: "Priya",
    phone: "9876543213"
  },
  {
    id: 5,
    name: "Smart Watch",
    category: "Electronics",
    status: "Found",
    date: "2026-11-14",
    location: "Sports Ground",
    description: "A black smartwatch found after a sports event.",
    reporter: "Vijay",
    phone: "9876543214"
  }
];

// Load data from localStorage
let items;

try {
  const savedItems = localStorage.getItem("finditItems");
  items = savedItems ? JSON.parse(savedItems) : sampleItems;
  if (!Array.isArray(items)) items = sampleItems;
} catch {
  items = sampleItems;
}

let reportStatus = "Lost";

const icons = {
  Electronics: "📱",
  Bags: "🎒",
  Documents: "📄",
  Accessories: "⌚",
  Clothing: "👕",
  Others: "📦"
};

function saveItems() {
  localStorage.setItem("finditItems", JSON.stringify(items));
}

// Update dashboard
function updateDashboard() {
  document.getElementById("totalCount").textContent = items.length;

  document.getElementById("lostCount").textContent =
    items.filter(item => item.status === "Lost").length;

  document.getElementById("foundCount").textContent =
    items.filter(item => item.status === "Found").length;

  document.getElementById("returnedCount").textContent =
    items.filter(item => item.status === "Returned").length;
}

// Escape user-provided text before displaying it as HTML
function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  }[char]));
}

// Display listings
function displayItems() {
  const grid = document.getElementById("itemGrid");

  const search = document.getElementById("searchInput")
    .value.toLowerCase().trim();

  const category = document.getElementById("categoryFilter").value;
  const status = document.getElementById("statusFilter").value;

  const filtered = items.filter(item => {
    const matchesSearch =
      item.name.toLowerCase().includes(search) ||
      item.description.toLowerCase().includes(search) ||
      item.location.toLowerCase().includes(search);

    const matchesCategory =
      category === "All" || item.category === category;

    const matchesStatus =
      status === "All" || item.status === status;

    return matchesSearch && matchesCategory && matchesStatus;
  });

  if (filtered.length === 0) {
    grid.innerHTML =
      '<div class="empty" style="grid-column:1/-1">No matching items found.</div>';
    return;
  }

  grid.innerHTML = filtered.map(item => `
    <div class="item-card">
      <div class="item-icon">${icons[item.category] || "📦"}</div>

      <span class="tag ${item.status.toLowerCase()}">
        ${escapeHTML(item.status)}
      </span>

      <h3>${escapeHTML(item.name)}</h3>

      <p>📂 ${escapeHTML(item.category)}</p>
      <p>📍 ${escapeHTML(item.location)}</p>
      <p>📅 ${escapeHTML(item.date)}</p>

      <p>${escapeHTML(item.description)}</p>

      <div class="card-actions">
        <button onclick="viewDetails(${item.id})">
          View Details
        </button>

        ${item.status !== "Returned" ? `
          <button class="secondary"
            onclick="markReturned(${item.id})">
            Mark Returned
          </button>
        ` : ""}

        <button class="danger"
          onclick="deleteItem(${item.id})">
          Delete
        </button>
      </div>
    </div>
  `).join("");
}

// Open report form
function openForm(status) {
  reportStatus = status;

  document.getElementById("formTitle").textContent =
    "Report " + status + " Item";

  const dateInput = document.getElementById("itemDate");
  dateInput.max = new Date().toLocaleDateString("en-CA");
  dateInput.value = dateInput.max;

  document.getElementById("itemForm").reset();
  dateInput.value = dateInput.max;

  document.getElementById("formModal").classList.remove("hidden");
}

// Close report form
function closeForm() {
  document.getElementById("formModal").classList.add("hidden");
}

// Submit new listing
document.getElementById("itemForm").addEventListener("submit", function(e) {
  e.preventDefault();

  const phone = document.getElementById("reporterPhone").value.trim();
  const date = document.getElementById("itemDate").value;
  const today = new Date().toLocaleDateString("en-CA");

  if (!/^[6-9]\d{9}$/.test(phone)) {
    alert("Enter a valid 10-digit Indian mobile number.");
    return;
  }

  if (!date || date > today) {
    alert("Please select a valid date (not in the future).");
    return;
  }

  const newItem = {
    id: Date.now(),
    name: document.getElementById("itemName").value.trim(),
    category: document.getElementById("itemCategory").value,
    status: reportStatus,
    date: date,
    location: document.getElementById("itemLocation").value.trim(),
    description: document.getElementById("itemDescription").value.trim(),
    reporter: document.getElementById("reporterName").value.trim(),
    phone: phone
  };

  if (!newItem.name || !newItem.location ||
      !newItem.description || !newItem.reporter) {
    alert("Please complete all required fields.");
    return;
  }

  items.unshift(newItem);
  saveItems();
  refresh();

  closeForm();
  alert(reportStatus + " item reported successfully!");
});

// View item details
function viewDetails(id) {
  const item = items.find(i => i.id === id);
  if (!item) return;

  document.getElementById("detailsContent").innerHTML = `
    <div class="details">
      <h3>${escapeHTML(item.name)}</h3>
      <p><strong>Category:</strong> ${escapeHTML(item.category)}</p>
      <p><strong>Status:</strong> ${escapeHTML(item.status)}</p>
      <p><strong>Date:</strong> ${escapeHTML(item.date)}</p>
      <p><strong>Location:</strong> ${escapeHTML(item.location)}</p>
      <p><strong>Description:</strong> ${escapeHTML(item.description)}</p>
      <p><strong>Reported by:</strong> ${escapeHTML(item.reporter)}</p>
      <p><strong>Contact:</strong> ${escapeHTML(item.phone)}</p>
    </div>
  `;

  document.getElementById("detailsModal").classList.remove("hidden");
}

function closeDetails() {
  document.getElementById("detailsModal").classList.add("hidden");
}

// Mark item as returned
function markReturned(id) {
  const item = items.find(i => i.id === id);
  if (!item) return;

  if (confirm("Mark this item as returned to its owner?")) {
    item.status = "Returned";
    saveItems();
    refresh();
  }
}

// Delete listing
function deleteItem(id) {
  if (!confirm("Are you sure you want to delete this listing?")) return;

  items = items.filter(item => item.id !== id);
  saveItems();
  refresh();
}

// Refresh all data
function refresh() {
  updateDashboard();
  displayItems();
}

// Search and filters
document.getElementById("searchInput")
  .addEventListener("input", displayItems);

document.getElementById("categoryFilter")
  .addEventListener("change", displayItems);

document.getElementById("statusFilter")
  .addEventListener("change", displayItems);

// Close modal when clicking outside the box
document.getElementById("formModal").addEventListener("click", e => {
  if (e.target.id === "formModal") closeForm();
});

document.getElementById("detailsModal").addEventListener("click", e => {
  if (e.target.id === "detailsModal") closeDetails();
});

// Initial display
refresh();

</script>

</body>
</html>
