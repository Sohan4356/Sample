<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Real-Time Dashboard</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f9;
            color: #222;
        }

        header {
            background: #1e293b;
            color: white;
            padding: 22px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        header h1 {
            font-size: 24px;
        }

        #clock {
            font-size: 18px;
        }

        main {
            padding: 30px;
            max-width: 1200px;
            margin: auto;
        }

        .status {
            margin-bottom: 20px;
            color: #15803d;
            font-size: 14px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(
                auto-fit, minmax(200px, 1fr)
            );
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        }

        .card h3 {
            color: #64748b;
            font-size: 15px;
            margin-bottom: 15px;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
        }

        .positive {
            color: #16a34a;
            font-size: 13px;
            margin-top: 10px;
        }

        .content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }

        .panel {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
            min-width: 0;
        }

        .panel h2 {
            font-size: 19px;
            margin-bottom: 20px;
        }

        .chart-container {
            position: relative;
            height: 300px;
        }

        .activity {
            padding: 15px 0;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            line-height: 1.6;
        }

        .activity:last-child {
            border-bottom: none;
        }

        .activity span {
            display: block;
            color: #64748b;
            font-size: 12px;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #64748b;
            font-size: 13px;
        }

        @media (max-width: 750px) {
            main {
                padding: 18px;
            }

            .content {
                grid-template-columns: 1fr;
            }

            header {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>📊 Admin Dashboard</h1>
        <div id="clock">Loading time...</div>
    </header>

    <main>

        <p class="status">
            ● Dashboard simulation running
        </p>

        <!-- Statistics -->
        <section class="cards">

            <div class="card">
                <h3>Total Revenue</h3>
                <p id="revenue">₹25,000</p>
                <div class="positive">↑ 12% this month</div>
            </div>

            <div class="card">
                <h3>Total Orders</h3>
                <p id="orders">150</p>
                <div class="positive">Orders received</div>
            </div>

            <div class="card">
                <h3>Active Users</h3>
                <p id="users">85</p>
                <div class="positive">Users online (simulated)</div>
            </div>

            <div class="card">
                <h3>Products</h3>
                <p id="products">320</p>
                <div class="positive">Products listed</div>
            </div>

        </section>

        <!-- Chart and Activities -->
        <section class="content">

            <div class="panel">
                <h2>Sales Overview</h2>

                <div class="chart-container">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>

            <div class="panel">
                <h2>Recent Activity</h2>

                <div id="activities">
                    <div class="activity">
                        🛒 New order received
                        <span>Just now</span>
                    </div>

                    <div class="activity">
                        👤 New user registered
                        <span>2 minutes ago</span>
                    </div>

                    <div class="activity">
                        💰 Payment completed
                        <span>5 minutes ago</span>
                    </div>

                    <div class="activity">
                        📦 Product added
                        <span>10 minutes ago</span>
                    </div>
                </div>
            </div>

        </section>

    </main>

    <footer>
        Real-Time Dashboard | Built with HTML, CSS & JavaScript
    </footer>

    <script>
        // Live digital clock
        function updateClock() {
            const now = new Date();

            document.getElementById("clock").textContent =
                now.toLocaleDateString() + " | " +
                now.toLocaleTimeString();
        }

        updateClock();

        setInterval(updateClock, 1000);


        // Create sales chart
        const salesData = [120, 190, 150, 250, 220, 300, 280];

        const salesChart = new Chart(
            document.getElementById("salesChart"),
            {
                type: "line",

                data: {
                    labels: [
                        "Mon", "Tue", "Wed", "Thu",
                        "Fri", "Sat", "Sun"
                    ],

                    datasets: [{
                        label: "Sales (₹)",
                        data: salesData,
                        borderWidth: 3,
                        tension: 0.3,
                        fill: false
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            }
        );


        // Simulate live dashboard statistics
        function updateDashboard() {

            const revenue = document.getElementById("revenue");
            const orders = document.getElementById("orders");
            const users = document.getElementById("users");

            const currentRevenue =
                Number(revenue.textContent.replace(/[₹,]/g, ""));

            const currentOrders = Number(orders.textContent);
            const currentUsers = Number(users.textContent);

            // Simulate a new order occasionally
            if (Math.random() < 0.4) {

                revenue.textContent =
                    "₹" + (currentRevenue + 500)
                        .toLocaleString("en-IN");

                orders.textContent = currentOrders + 1;

                addActivity("🛒 New order received");
            }

            // Simulate changing online users
            const change = Math.floor(Math.random() * 7) - 3;

            users.textContent =
                Math.max(0, currentUsers + change);

            // Update the latest sales chart point
            salesData.push(
                Math.floor(Math.random() * 300) + 100
            );

            salesData.shift();

            salesChart.update();
        }


        // Add a new activity
        function addActivity(message) {

            const activities =
                document.getElementById("activities");

            const activity = document.createElement("div");

            activity.className = "activity";

            const text = document.createElement("div");
            text.textContent = message;

            const time = document.createElement("span");
            time.textContent = new Date().toLocaleTimeString();

            activity.appendChild(text);
            activity.appendChild(time);

            activities.prepend(activity);

            // Keep only the latest five activities
            while (activities.children.length > 5) {
                activities.lastElementChild.remove();
            }
        }


        // Refresh simulated data every 3 seconds
        setInterval(updateDashboard, 3000);

    </script>

</body>
</html>
