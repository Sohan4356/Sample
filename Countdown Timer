<!DOCTYPE html>
<html>
<head>
    <title>Countdown Timer</title>

    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            text-align: center;
            padding: 60px;
        }

        .container {
            width: 400px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        input, button {
            padding: 12px;
            margin: 10px;
            font-size: 16px;
        }

        button {
            background: green;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        #timer {
            font-size: 40px;
            font-weight: bold;
            margin: 25px;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>⏳ Countdown Timer</h1>

    <input type="number" id="seconds"
           placeholder="Enter seconds">

    <button onclick="startTimer()">Start</button>

    <div id="timer">00:00</div>

</div>

<script>

function startTimer() {

    let seconds = Number(
        document.getElementById("seconds").value
    );

    if (seconds <= 0) {
        alert("Please enter a valid number!");
        return;
    }

    let timer = document.getElementById("timer");

    let countdown = setInterval(function() {

        let minutes = Math.floor(seconds / 60);
        let remainingSeconds = seconds % 60;

        timer.innerText =
            String(minutes).padStart(2, "0") + ":" +
            String(remainingSeconds).padStart(2, "0");

        seconds--;

        if (seconds < 0) {

            clearInterval(countdown);

            timer.innerText = "Time's Up! ⏰";

            alert("Time's Up!");

        }

    }, 1000);
}

</script>

</body>
</html>
