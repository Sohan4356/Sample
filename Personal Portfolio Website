<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f5f5f5;
            color: #333;
        }

        /* Navigation */
        nav {
            background-color: #222;
            padding: 20px;
            text-align: center;
        }

        nav h2 {
            color: white;
            margin-bottom: 10px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
        }

        nav a:hover {
            color: #00adb5;
        }

        /* Home */
        #home {
            text-align: center;
            padding: 100px 20px;
            background-color: #00adb5;
            color: white;
        }

        #home h1 {
            font-size: 45px;
            margin-bottom: 15px;
        }

        #home p {
            font-size: 20px;
        }

        /* Sections */
        section {
            padding: 60px 10%;
        }

        section h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 30px;
        }

        /* About */
        .about {
            text-align: center;
            max-width: 700px;
            margin: auto;
            line-height: 1.7;
        }

        /* Skills */
        .skills {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .skill {
            background-color: white;
            padding: 20px 30px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        /* Projects */
        .projects {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .project {
            background-color: white;
            width: 280px;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        .project h3 {
            margin-bottom: 10px;
            color: #00adb5;
        }

        /* Contact */
        .contact {
            text-align: center;
        }

        input,
        textarea {
            width: 80%;
            padding: 12px;
            margin: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            padding: 12px 25px;
            background-color: #00adb5;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #008b91;
        }

        /* Footer */
        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <h2>My Portfolio</h2>

        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
    </nav>


    <!-- Home -->
    <section id="home">
        <h1>Hello, I'm Sohan 👋</h1>
        <p>Computer Science Student | Programmer | Web Developer</p>
    </section>


    <!-- About -->
    <section id="about">

        <h2>About Me</h2>

        <div class="about">
            <p>
                I am a Computer Science student interested in
                programming, web development and software development.
                I enjoy learning new technologies and building
                useful projects.
            </p>
        </div>

    </section>


    <!-- Skills -->
    <section id="skills">

        <h2>My Skills</h2>

        <div class="skills">

            <div class="skill">C</div>
            <div class="skill">C++</div>
            <div class="skill">Java</div>
            <div class="skill">Python</div>
            <div class="skill">HTML</div>
            <div class="skill">CSS</div>
            <div class="skill">JavaScript</div>

        </div>

    </section>


    <!-- Projects -->
    <section id="projects">

        <h2>My Projects</h2>

        <div class="projects">

            <div class="project">
                <h3>Location Alarm App</h3>
                <p>
                    An application that alerts users when
                    they reach their selected location.
                </p>
            </div>

            <div class="project">
                <h3>Student Management System</h3>
                <p>
                    A simple application for storing and
                    managing student information.
                </p>
            </div>

            <div class="project">
                <h3>Personal Portfolio</h3>
                <p>
                    A responsive website to showcase my
                    skills, education and projects.
                </p>
            </div>

        </div>

    </section>


    <!-- Contact -->
    <section id="contact">

        <h2>Contact Me</h2>

        <div class="contact">

            <input type="text" id="name" placeholder="Your Name">
            <br>

            <input type="email" id="email" placeholder="Your Email">
            <br>

            <textarea id="message" rows="5"
                placeholder="Your Message"></textarea>
            <br>

            <button onclick="sendMessage()">Send Message</button>

        </div>

    </section>


    <!-- Footer -->
    <footer>
        <p>© 2026 Sohan. All Rights Reserved.</p>
    </footer>


    <!-- JavaScript -->
    <script>

        function sendMessage() {

            let name = document.getElementById("name").value;

            if (name === "") {
                alert("Please enter your name.");
            } else {
                alert("Thank you, " + name + "!");
            }

        }

    </script>

</body>

</html>
